		@json("new_chat_members", omitempty = true)
		newChatMembers User[]
		// A member was removed from the group, information about them (this member may be the bot
		// itself)
		@json("left_chat_member", omitempty = true)
		leftChatMember ?User = none
		// Service message: chat owner has left
		@json("chat_owner_left", omitempty = true)
		chatOwnerLeft ?ChatOwnerLeft = none
		// Service message: chat owner has changed
		@json("chat_owner_changed", omitempty = true)
		chatOwnerChanged ?ChatOwnerChanged = none
		// A chat title was changed to this value
		@json("new_chat_title", omitempty = true)
		newChatTitle string
		// A chat photo was change to this value
		@json("new_chat_photo", omitempty = true)
		newChatPhoto PhotoSize[]
		// Service message: the chat photo was deleted
		@json("delete_chat_photo", omitempty = true)
		deleteChatPhoto bool
		// Service message: the group has been created
		@json("group_chat_created", omitempty = true)
		groupChatCreated bool
		// Service message: the supergroup has been created.
		@json("supergroup_chat_created", omitempty = true)
		supergroupChatCreated bool
		// Service message: the channel has been created.
		@json("channel_chat_created", omitempty = true)
		channelChatCreated bool
		// Service message: auto-delete timer settings changed in the chat
		@json("message_auto_delete_timer_changed", omitempty = true)
		messageAutoDeleteTimerChanged ?MessageAutoDeleteTimerChanged = none
		// The group has been migrated to a supergroup with the specified identifier.
		@json("migrate_to_chat_id", omitempty = true)
		migrateToChatId int
		// The supergroup has been migrated from a group with the specified identifier.
		@json("migrate_from_chat_id", omitempty = true)
		migrateFromChatId int
		// Specified message was pinned.
		@json("pinned_message", omitempty = true)
		pinnedMessage ?MaybeInaccessibleMessage = none
		// Message is an invoice for a payment, information about the invoice.
		@json(omitempty = true)
		invoice ?Invoice = none
		// Message is a service message about a successful payment, information about the payment.
		@json("successful_payment", omitempty = true)
		successfulPayment ?SuccessfulPayment = none
		// Message is a service message about a refunded payment, information about the payment.
		@json("refunded_payment", omitempty = true)
		refundedPayment ?RefundedPayment = none
		// Service message: users were shared with the bot
		@json("users_shared", omitempty = true)
		usersShared ?UsersShared = none
		// Service message: a chat was shared with the bot
		@json("chat_shared", omitempty = true)
		chatShared ?ChatShared = none
		// Service message: a regular gift was sent or received
		@json(omitempty = true)
		gift ?GiftInfo = none
		// Service message: a unique gift was sent or received
		@json("unique_gift", omitempty = true)
		uniqueGift ?UniqueGiftInfo = none
		// Service message: upgrade of a gift was purchased after the gift was sent
		@json("gift_upgrade_sent", omitempty = true)
		giftUpgradeSent ?GiftInfo = none
		// The domain name of the website on which the user has logged in.
		@json("connected_website", omitempty = true)
		connectedWebsite string
		// Service message: the user allowed the bot to write messages after adding it to the
		// attachment or side menu, launching a Web App from a link, or accepting an explicit
		// request from a Web App sent by the method requestWriteAccess
		@json("write_access_allowed", omitempty = true)
		writeAccessAllowed ?WriteAccessAllowed = none
		// Telegram Passport data
		@json("passport_data", omitempty = true)
		passportData ?PassportData = none
		// Service message: a user in the chat triggered another user's proximity alert while
		// sharing Live Location
		@json("proximity_alert_triggered", omitempty = true)
		proximityAlertTriggered ?ProximityAlertTriggered = none
		// Service message: user boosted the chat
		@json("boost_added", omitempty = true)
		boostAdded ?ChatBoostAdded = none
		// Service message: chat background set
		@json("chat_background_set", omitempty = true)
		chatBackgroundSet ?ChatBackground = none
		// Service message: some tasks in a checklist were marked as done or not done
		@json("checklist_tasks_done", omitempty = true)
		checklistTasksDone ?ChecklistTasksDone = none
		// Service message: tasks were added to a checklist
		@json("checklist_tasks_added", omitempty = true)
		checklistTasksAdded ?ChecklistTasksAdded = none
		// Service message: chat or bot added to a Community
		@json("community_chat_added", omitempty = true)
		communityChatAdded ?CommunityChatAdded = none
		// Service message: chat was joined by a user from a Community
		@json("community_chat_joined", omitempty = true)
		communityChatJoined ?CommunityChatJoined = none
		// Service message: chat or bot removed from a Community
		@json("community_chat_removed", omitempty = true)
		communityChatRemoved ?CommunityChatRemoved = none
		// Service message: the price for paid messages in the corresponding direct messages chat
		// of a channel has changed
		@json("direct_message_price_changed", omitempty = true)
		directMessagePriceChanged ?DirectMessagePriceChanged = none
		// Service message: forum topic created
		@json("forum_topic_created", omitempty = true)
		forumTopicCreated ?ForumTopicCreated = none
		// Service message: forum topic edited
		@json("forum_topic_edited", omitempty = true)
		forumTopicEdited ?ForumTopicEdited = none
		// Service message: forum topic closed
		@json("forum_topic_closed", omitempty = true)
		forumTopicClosed ?ForumTopicClosed = none
		// Service message: forum topic reopened
		@json("forum_topic_reopened", omitempty = true)
		forumTopicReopened ?ForumTopicReopened = none
		// Service message: the 'General' forum topic hidden
		@json("general_forum_topic_hidden", omitempty = true)
		generalForumTopicHidden ?GeneralForumTopicHidden = none
		// Service message: the 'General' forum topic unhidden
		@json("general_forum_topic_unhidden", omitempty = true)
		generalForumTopicUnhidden ?GeneralForumTopicUnhidden = none
		// Service message: a scheduled giveaway was created
		@json("giveaway_created", omitempty = true)
		giveawayCreated ?GiveawayCreated = none
		// The message is a scheduled giveaway message
		@json(omitempty = true)
		giveaway ?Giveaway = none
		// A giveaway with public winners was completed
		@json("giveaway_winners", omitempty = true)
		giveawayWinners ?GiveawayWinners = none
		// Service message: a giveaway without public winners was completed
		@json("giveaway_completed", omitempty = true)
		giveawayCompleted ?GiveawayCompleted = none
