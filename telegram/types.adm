		// Optional.
		@json("start_timestamp", omitempty = true)
		startTimestamp int
		// Optional.
		@json(omitempty = true)
		width int
		// Optional.
		@json(omitempty = true)
		height int
		// Optional.
		@json(omitempty = true)
		duration int
		// Optional.
		@json("supports_streaming", omitempty = true)
		supportsStreaming bool
	}

