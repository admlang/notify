		suggestedPostApproved ?SuggestedPostApproved = none
		// Service message: approval of a suggested post has failed
		@json("suggested_post_approval_failed", omitempty = true)
		suggestedPostApprovalFailed ?SuggestedPostApprovalFailed = none
		// Service message: a suggested post was declined
		@json("suggested_post_declined", omitempty = true)
		suggestedPostDeclined ?SuggestedPostDeclined = none
