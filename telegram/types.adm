		businessConnectionId string
		// Chat the message belongs to
		@json(omitempty = true)
		chat ?Chat = none
		// Optional.
		@json("forward_origin", omitempty = true)
		forwardOrigin ?MessageOrigin = none
		// Optional.
		@json("is_topic_message", omitempty = true)
		isTopicMessage bool
		// Optional.
		@json("is_automatic_forward", omitempty = true)
		isAutomaticForward bool
		// Optional.
		@json("reply_to_message", omitempty = true)
		replyToMessage ?Message = none
		// Optional.
		@json("external_reply", omitempty = true)
		externalReply ?ExternalReplyInfo = none
		// Optional.
