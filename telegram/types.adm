		// Service message: data sent by a Web App
		@json("web_app_data", omitempty = true)
		webAppData ?WebAppData = none
		// Inline keyboard attached to the message.
		@json("reply_markup", omitempty = true)
		replyMarkup ?InlineKeyboardMarkup = none
	}

	// This object represents a unique message identifier.
	struct MessageId {
		// Unique message identifier.
		@json("message_id")
		messageId int
	}

	// This object describes a message that was deleted or is otherwise inaccessible to the bot.
	struct InaccessibleMessage {
		// Chat the message belonged to
		chat Chat
		// Unique message identifier inside the chat
		@json("message_id")
		messageId int
		// Always 0.
		date int
	}

	// This object describes a message that can be inaccessible to the bot.
	// One struct holds the fields of every kind: Message, InaccessibleMessage.
	struct MaybeInaccessibleMessage {
		// Unique message identifier inside this chat; 0 for ephemeral messages.
		@json("message_id", omitempty = true)
		messageId int
		// Optional.
		@json("message_thread_id", omitempty = true)
		messageThreadId int
		// Optional.
		@json("direct_messages_topic", omitempty = true)
		directMessagesTopic ?DirectMessagesTopic = none
