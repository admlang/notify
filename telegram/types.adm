	// Describes the birthdate of a user.
	struct Birthdate {
		// Day of the user's birth; 1-31
		day int
		// Month of the user's birth; 1-12
		month int
		// Year of the user's birth
		@json(omitempty = true)
		year int
	}

	// Contains information about the start page settings of a Telegram Business account.
	struct BusinessIntro {
		// Title text of the business intro
		@json(omitempty = true)
		title string
		// Message text of the business intro
		@json(omitempty = true)
		message string
		// Sticker of the business intro
		@json(omitempty = true)
		sticker ?Sticker = none
	}

	// Contains information about the location of a Telegram Business account.
	struct BusinessLocation {
		// Address of the business
		address string
		// Location of the business
		@json(omitempty = true)
		location ?Location = none
	}

	// Describes an interval of time during which a business is open.
	struct BusinessOpeningHoursInterval {
		// The minute's sequence number in a week, starting on Monday, marking the start of the
		// time interval during which the business is open; 0 - 7 * 24 * 60
		@json("opening_minute")
		openingMinute int
		// The minute's sequence number in a week, starting on Monday, marking the end of the time
		// interval during which the business is open; 0 - 8 * 24 * 60
		@json("closing_minute")
		closingMinute int
	}

	// Describes the opening hours of a business.
	struct BusinessOpeningHours {
		// Unique name of the time zone for which the opening hours are defined
		@json("time_zone_name")
		timeZoneName string
		// List of time intervals describing business opening hours
		@json("opening_hours")
		openingHours BusinessOpeningHoursInterval[]
	}

	// This object describes the rating of a user based on their Telegram Star spendings.
	struct UserRating {
		// Current level of the user, indicating their reliability when purchasing digital goods
		// and services.
		level int
		// Numerical value of the user's rating; the higher the rating, the better
		rating int
		// The rating value required to get the current level
		@json("current_level_rating")
		currentLevelRating int
		// The rating value required to get to the next level; omitted if the maximum level was
		// reached
		@json("next_level_rating", omitempty = true)
		nextLevelRating int
	}

	// Describes the position of a clickable area within a story.
	struct StoryAreaPosition {
		// The abscissa of the area's center, as a percentage of the media width
		@json("x_percentage")
		xPercentage float
		// The ordinate of the area's center, as a percentage of the media height
		@json("y_percentage")
		yPercentage float
		// The width of the area's rectangle, as a percentage of the media width
		@json("width_percentage")
		widthPercentage float
		// The height of the area's rectangle, as a percentage of the media height
		@json("height_percentage")
		heightPercentage float
		// The clockwise rotation angle of the rectangle, in degrees; 0-360
		@json("rotation_angle")
		rotationAngle float
		// The radius of the rectangle corner rounding, as a percentage of the media width
		@json("corner_radius_percentage")
		cornerRadiusPercentage float
	}

	// Describes the physical address of a location.
	struct LocationAddress {
		// The two-letter ISO 3166-1 alpha-2 country code of the country where the location is
		// located
		@json("country_code")
		countryCode string
		// State of the location
		@json(omitempty = true)
		state string
		// City of the location
		@json(omitempty = true)
		city string
		// Street address of the location
		@json(omitempty = true)
		street string
	}

	// Describes the type of a clickable area on a story.
	// One struct holds the fields of every kind: StoryAreaTypeLocation, StoryAreaTypeSuggestedReaction, StoryAreaTypeLink, StoryAreaTypeWeather, StoryAreaTypeUniqueGift.
	struct StoryAreaType {
		// Type of the area, always “location”
		@json("type", omitempty = true)
		kind string
		// Location latitude in degrees
		@json(omitempty = true)
		latitude float
		// Location longitude in degrees
		@json(omitempty = true)
		longitude float
		// Optional.
		@json(omitempty = true)
		address ?LocationAddress = none
		// Type of the reaction
		@json("reaction_type", omitempty = true)
		reactionType ?ReactionType = none
		// Optional.
		@json("is_dark", omitempty = true)
		isDark bool
		// Optional.
		@json("is_flipped", omitempty = true)
		isFlipped bool
		// HTTP or tg:// URL to be opened when the area is clicked
		@json(omitempty = true)
		url string
		// Temperature, in degree Celsius
		@json(omitempty = true)
		temperature float
		// Emoji representing the weather
		@json(omitempty = true)
		emoji string
		// A color of the area background in the ARGB format
		@json("background_color", omitempty = true)
		backgroundColor int
		// Unique name of the gift
		@json(omitempty = true)
		name string
	}

	// Describes a story area pointing to a location.
	struct StoryAreaTypeLocation {
		// Type of the area, always “location”
		@json("type")
		kind string
		// Location latitude in degrees
		latitude float
		// Location longitude in degrees
		longitude float
		// Address of the location
		@json(omitempty = true)
		address ?LocationAddress = none
	}

	// Describes a story area pointing to a suggested reaction.
	struct StoryAreaTypeSuggestedReaction {
		// Type of the area, always “suggested_reaction”
		@json("type")
		kind string
		// Type of the reaction
		@json("reaction_type")
		reactionType ReactionType
		// Pass True if the reaction area has a dark background
		@json("is_dark", omitempty = true)
		isDark bool
		// Pass True if reaction area corner is flipped
		@json("is_flipped", omitempty = true)
		isFlipped bool
	}

	// Describes a story area pointing to an HTTP or tg:// link.
	struct StoryAreaTypeLink {
		// Type of the area, always “link”
		@json("type")
		kind string
		// HTTP or tg:// URL to be opened when the area is clicked
		url string
	}

	// Describes a story area containing weather information.
	struct StoryAreaTypeWeather {
		// Type of the area, always “weather”
		@json("type")
		kind string
		// Temperature, in degree Celsius
		temperature float
		// Emoji representing the weather
		emoji string
		// A color of the area background in the ARGB format
		@json("background_color")
		backgroundColor int
	}

	// Describes a story area pointing to a unique gift.
	struct StoryAreaTypeUniqueGift {
		// Type of the area, always “unique_gift”
		@json("type")
		kind string
		// Unique name of the gift
		name string
	}

	// Describes a clickable area on a story media.
	struct StoryArea {
		// Position of the area
		position StoryAreaPosition
		// Type of the area
		@json("type")
		kind StoryAreaType
	}

	// Represents a location to which a chat is connected.
	struct ChatLocation {
		// The location to which the supergroup is connected.
		location Location
		// Location address; 1-64 characters, as defined by the chat owner
		address string
	}

	// This object describes the type of a reaction.
	// One struct holds the fields of every kind: ReactionTypeEmoji, ReactionTypeCustomEmoji, ReactionTypePaid.
	struct ReactionType {
		// Type of the reaction, always “emoji”
		@json("type", omitempty = true)
		kind string
		// Reaction emoji.
		@json(omitempty = true)
		emoji string
		// Custom emoji identifier
		@json("custom_emoji_id", omitempty = true)
		customEmojiId string
	}

	// The reaction is based on an emoji.
	struct ReactionTypeEmoji {
		// Type of the reaction, always “emoji”
		@json("type")
		kind string
		// Reaction emoji.
		emoji string
	}

	// The reaction is based on a custom emoji.
	struct ReactionTypeCustomEmoji {
		// Type of the reaction, always “custom_emoji”
		@json("type")
		kind string
		// Custom emoji identifier
		@json("custom_emoji_id")
		customEmojiId string
	}

	// The reaction is paid.
	struct ReactionTypePaid {
		// Type of the reaction, always “paid”
		@json("type")
		kind string
	}

	// Represents a reaction added to a message along with the number of times it was added.
	struct ReactionCount {
		// Type of the reaction
		@json("type")
		kind ReactionType
		// Number of times the reaction was added
		@json("total_count")
		totalCount int
	}

	// This object represents a change of a reaction on a message performed by a user.
	struct MessageReactionUpdated {
		// The chat containing the message the user reacted to
		chat Chat
		// Unique identifier of the message inside the chat
		@json("message_id")
		messageId int
		// The user that changed the reaction, if the user isn't anonymous
		@json(omitempty = true)
		user ?User = none
		// The chat on behalf of which the reaction was changed, if the user is anonymous
		@json("actor_chat", omitempty = true)
		actorChat ?Chat = none
		// Date of the change in Unix time
		date int
		// Previous list of reaction types that were set by the user
		@json("old_reaction")
		oldReaction ReactionType[]
		// New list of reaction types that have been set by the user
		@json("new_reaction")
		newReaction ReactionType[]
	}

	// This object represents reaction changes on a message with anonymous reactions.
	struct MessageReactionCountUpdated {
		// The chat containing the message
		chat Chat
		// Unique message identifier inside the chat
		@json("message_id")
		messageId int
		// Date of the change in Unix time
		date int
		// List of reactions that are present on the message
		reactions ReactionCount[]
	}

	// This object represents a forum topic.
	struct ForumTopic {
		// Unique identifier of the forum topic
		@json("message_thread_id")
		messageThreadId int
		// Name of the topic
		name string
		// Color of the topic icon in RGB format
		@json("icon_color")
		iconColor int
		// Unique identifier of the custom emoji shown as the topic icon
		@json("icon_custom_emoji_id", omitempty = true)
		iconCustomEmojiId string
		// True, if the name of the topic wasn't specified explicitly by its creator and likely
		// needs to be changed by the bot
		@json("is_name_implicit", omitempty = true)
		isNameImplicit bool
	}

	// This object describes the background of a gift.
	struct GiftBackground {
		// Center color of the background in RGB format
		@json("center_color")
		centerColor int
		// Edge color of the background in RGB format
		@json("edge_color")
		edgeColor int
		// Text color of the background in RGB format
		@json("text_color")
		textColor int
	}

	// This object represents a gift that can be sent by the bot.
	struct Gift {
		// Unique identifier of the gift
		id string
		// The sticker that represents the gift
		sticker Sticker
		// The number of Telegram Stars that must be paid to send the sticker
		@json("star_count")
		starCount int
		// The number of Telegram Stars that must be paid to upgrade the gift to a unique one
		@json("upgrade_star_count", omitempty = true)
		upgradeStarCount int
		// True, if the gift can only be purchased by Telegram Premium subscribers
		@json("is_premium", omitempty = true)
		isPremium bool
		// True, if the gift can be used (after being upgraded) to customize a user's appearance
		@json("has_colors", omitempty = true)
		hasColors bool
		// The total number of gifts of this type that can be sent by all users; for limited gifts
		// only
		@json("total_count", omitempty = true)
		totalCount int
		// The number of remaining gifts of this type that can be sent by all users; for limited
		// gifts only
		@json("remaining_count", omitempty = true)
		remainingCount int
		// The total number of gifts of this type that can be sent by the bot; for limited gifts
		// only
		@json("personal_total_count", omitempty = true)
		personalTotalCount int
		// The number of remaining gifts of this type that can be sent by the bot; for limited
		// gifts only
		@json("personal_remaining_count", omitempty = true)
		personalRemainingCount int
		// Background of the gift
		@json(omitempty = true)
		background ?GiftBackground = none
		// The total number of different unique gifts that can be obtained by upgrading the gift
		@json("unique_gift_variant_count", omitempty = true)
		uniqueGiftVariantCount int
		// Information about the chat that published the gift
		@json("publisher_chat", omitempty = true)
		publisherChat ?Chat = none
	}

	// This object represent a list of gifts.
	struct Gifts {
		// The list of gifts
		gifts Gift[]
	}

	// This object describes the model of a unique gift.
	struct UniqueGiftModel {
		// Name of the model
		name string
		// The sticker that represents the unique gift
		sticker Sticker
		// The number of unique gifts that receive this model for every 1000 gift upgrades.
		@json("rarity_per_mille")
		rarityPerMille int
		// Rarity of the model if it is a crafted model.
		@json(omitempty = true)
		rarity string
	}

	// This object describes the symbol shown on the pattern of a unique gift.
	struct UniqueGiftSymbol {
		// Name of the symbol
		name string
		// The sticker that represents the unique gift
		sticker Sticker
		// The number of unique gifts that receive this model for every 1000 gifts upgraded
		@json("rarity_per_mille")
		rarityPerMille int
	}

	// This object describes the colors of the backdrop of a unique gift.
	struct UniqueGiftBackdropColors {
		// The color in the center of the backdrop in RGB format
		@json("center_color")
		centerColor int
		// The color on the edges of the backdrop in RGB format
		@json("edge_color")
		edgeColor int
		// The color to be applied to the symbol in RGB format
		@json("symbol_color")
		symbolColor int
		// The color for the text on the backdrop in RGB format
		@json("text_color")
		textColor int
	}

	// This object describes the backdrop of a unique gift.
	struct UniqueGiftBackdrop {
		// Name of the backdrop
		name string
		// Colors of the backdrop
		colors UniqueGiftBackdropColors
		// The number of unique gifts that receive this backdrop for every 1000 gifts upgraded
		@json("rarity_per_mille")
		rarityPerMille int
	}

	// This object contains information about the color scheme for a user's name, message
	// replies and link previews based on a unique gift.
	struct UniqueGiftColors {
		// Custom emoji identifier of the unique gift's model
		@json("model_custom_emoji_id")
		modelCustomEmojiId string
		// Custom emoji identifier of the unique gift's symbol
		@json("symbol_custom_emoji_id")
		symbolCustomEmojiId string
		// Main color used in light themes; RGB format
		@json("light_theme_main_color")
		lightThemeMainColor int
		// List of 1-3 additional colors used in light themes; RGB format
		@json("light_theme_other_colors")
		lightThemeOtherColors int[]
		// Main color used in dark themes; RGB format
		@json("dark_theme_main_color")
		darkThemeMainColor int
		// List of 1-3 additional colors used in dark themes; RGB format
		@json("dark_theme_other_colors")
		darkThemeOtherColors int[]
	}

	// This object describes a unique gift that was upgraded from a regular gift.
	struct UniqueGift {
		// Identifier of the regular gift from which the gift was upgraded
		@json("gift_id")
		giftId string
		// Human-readable name of the regular gift from which this unique gift was upgraded
		@json("base_name")
		baseName string
		// Unique name of the gift.
		name string
		// Unique number of the upgraded gift among gifts upgraded from the same regular gift
		number int
		// Model of the gift
		model UniqueGiftModel
		// Symbol of the gift
		symbol UniqueGiftSymbol
		// Backdrop of the gift
		backdrop UniqueGiftBackdrop
		// True, if the original regular gift was exclusively purchaseable by Telegram Premium
		// subscribers
		@json("is_premium", omitempty = true)
		isPremium bool
		// True, if the gift was used to craft another gift and isn't available anymore
		@json("is_burned", omitempty = true)
		isBurned bool
		// True, if the gift is assigned from the TON blockchain and can't be resold or transferred
		// in Telegram
		@json("is_from_blockchain", omitempty = true)
		isFromBlockchain bool
		// The color scheme that can be used by the gift's owner for the chat's name, replies to
		// messages and link previews; for business account gifts and gifts that are currently on
		// sale only
		@json(omitempty = true)
		colors ?UniqueGiftColors = none
		// Information about the chat that published the gift
		@json("publisher_chat", omitempty = true)
		publisherChat ?Chat = none
	}

	// Describes a service message about a regular gift that was sent or received.
	struct GiftInfo {
		// Information about the gift
		gift Gift
		// Unique identifier of the received gift for the bot; only present for gifts received on
		// behalf of business accounts
		@json("owned_gift_id", omitempty = true)
		ownedGiftId string
		// Number of Telegram Stars that can be claimed by the receiver by converting the gift;
		// omitted if conversion to Telegram Stars is impossible
		@json("convert_star_count", omitempty = true)
		convertStarCount int
		// Number of Telegram Stars that were prepaid for the ability to upgrade the gift
		@json("prepaid_upgrade_star_count", omitempty = true)
		prepaidUpgradeStarCount int
		// True, if the gift's upgrade was purchased after the gift was sent
		@json("is_upgrade_separate", omitempty = true)
		isUpgradeSeparate bool
		// True, if the gift can be upgraded to a unique gift
		@json("can_be_upgraded", omitempty = true)
		canBeUpgraded bool
		// Text of the message that was added to the gift
		@json(omitempty = true)
		text string
		// Special entities that appear in the text
		@json(omitempty = true)
		entities MessageEntity[]
		// True, if the sender and gift text are shown only to the gift receiver; otherwise,
		// everyone will be able to see them
		@json("is_private", omitempty = true)
		isPrivate bool
		// Unique number reserved for this gift when upgraded.
		@json("unique_gift_number", omitempty = true)
		uniqueGiftNumber int
	}

	// Describes a service message about a unique gift that was sent or received.
	struct UniqueGiftInfo {
		// Information about the gift
		gift UniqueGift
		// Origin of the gift.
		origin string
		// Text of the message that was added to the gift
		@json(omitempty = true)
		text string
		// Special entities that appear in the text
		@json(omitempty = true)
		entities MessageEntity[]
		// True, if the sender and gift text are shown only to the gift receiver; otherwise,
		// everyone will be able to see them
		@json("is_private", omitempty = true)
		isPrivate bool
		// For gifts bought from other users, the currency in which the payment for the gift was
		// done.
		@json("last_resale_currency", omitempty = true)
		lastResaleCurrency string
		// For gifts bought from other users, the price paid for the gift in either Telegram Stars
		// or nanograms
		@json("last_resale_amount", omitempty = true)
		lastResaleAmount int
		// Unique identifier of the received gift for the bot; only present for gifts received on
		// behalf of business accounts
		@json("owned_gift_id", omitempty = true)
		ownedGiftId string
		// Number of Telegram Stars that must be paid to transfer the gift; omitted if the bot
		// cannot transfer the gift
		@json("transfer_star_count", omitempty = true)
		transferStarCount int
		// Point in time (Unix timestamp) when the gift can be transferred.
		@json("next_transfer_date", omitempty = true)
		nextTransferDate int
	}

	// This object describes a gift received and owned by a user or a chat.
	// One struct holds the fields of every kind: OwnedGiftRegular, OwnedGiftUnique.
	struct OwnedGift {
		// Type of the gift, always “regular”
		@json("type", omitempty = true)
		kind string
		// Information about the regular gift
		@json(omitempty = true)
		gift ?Gift = none
		// Optional.
		@json("owned_gift_id", omitempty = true)
		ownedGiftId string
		// Optional.
		@json("sender_user", omitempty = true)
		senderUser ?User = none
		// Date the gift was sent in Unix time
		@json("send_date", omitempty = true)
		sendDate int
		// Optional.
		@json(omitempty = true)
		text string
		// Optional.
		@json(omitempty = true)
		entities MessageEntity[]
		// Optional.
		@json("is_private", omitempty = true)
		isPrivate bool
		// Optional.
		@json("is_saved", omitempty = true)
		isSaved bool
		// Optional.
		@json("can_be_upgraded", omitempty = true)
		canBeUpgraded bool
		// Optional.
		@json("was_refunded", omitempty = true)
		wasRefunded bool
		// Optional.
		@json("convert_star_count", omitempty = true)
		convertStarCount int
		// Optional.
		@json("prepaid_upgrade_star_count", omitempty = true)
		prepaidUpgradeStarCount int
		// Optional.
		@json("is_upgrade_separate", omitempty = true)
		isUpgradeSeparate bool
		// Optional.
		@json("unique_gift_number", omitempty = true)
		uniqueGiftNumber int
		// Optional.
		@json("can_be_transferred", omitempty = true)
		canBeTransferred bool
		// Optional.
		@json("transfer_star_count", omitempty = true)
		transferStarCount int
		// Optional.
		@json("next_transfer_date", omitempty = true)
		nextTransferDate int
	}

	// Describes a regular gift owned by a user or a chat.
	struct OwnedGiftRegular {
		// Type of the gift, always “regular”
		@json("type")
		kind string
		// Information about the regular gift
		gift Gift
		// Unique identifier of the gift for the bot; for gifts received on behalf of business
		// accounts only
		@json("owned_gift_id", omitempty = true)
		ownedGiftId string
		// Sender of the gift if it is a known user
		@json("sender_user", omitempty = true)
		senderUser ?User = none
		// Date the gift was sent in Unix time
		@json("send_date")
		sendDate int
		// Text of the message that was added to the gift
		@json(omitempty = true)
		text string
		// Special entities that appear in the text
		@json(omitempty = true)
		entities MessageEntity[]
		// True, if the sender and gift text are shown only to the gift receiver; otherwise,
		// everyone will be able to see them
		@json("is_private", omitempty = true)
		isPrivate bool
		// True, if the gift is displayed on the account's profile page; for gifts received on
		// behalf of business accounts only
		@json("is_saved", omitempty = true)
		isSaved bool
		// True, if the gift can be upgraded to a unique gift; for gifts received on behalf of
		// business accounts only
		@json("can_be_upgraded", omitempty = true)
		canBeUpgraded bool
		// True, if the gift was refunded and isn't available anymore
		@json("was_refunded", omitempty = true)
		wasRefunded bool
		// Number of Telegram Stars that can be claimed by the receiver instead of the gift;
		// omitted if the gift cannot be converted to Telegram Stars; for gifts received on behalf
		// of business accounts only
		@json("convert_star_count", omitempty = true)
		convertStarCount int
		// Number of Telegram Stars that were paid for the ability to upgrade the gift
		@json("prepaid_upgrade_star_count", omitempty = true)
		prepaidUpgradeStarCount int
		// True, if the gift's upgrade was purchased after the gift was sent; for gifts received on
		// behalf of business accounts only
		@json("is_upgrade_separate", omitempty = true)
		isUpgradeSeparate bool
		// Unique number reserved for this gift when upgraded.
		@json("unique_gift_number", omitempty = true)
		uniqueGiftNumber int
	}

	// Describes a unique gift received and owned by a user or a chat.
	struct OwnedGiftUnique {
		// Type of the gift, always “unique”
		@json("type")
		kind string
		// Information about the unique gift
		gift UniqueGift
		// Unique identifier of the received gift for the bot; for gifts received on behalf of
		// business accounts only
		@json("owned_gift_id", omitempty = true)
		ownedGiftId string
		// Sender of the gift if it is a known user
		@json("sender_user", omitempty = true)
		senderUser ?User = none
		// Date the gift was sent in Unix time
		@json("send_date")
		sendDate int
		// True, if the gift is displayed on the account's profile page; for gifts received on
		// behalf of business accounts only
		@json("is_saved", omitempty = true)
		isSaved bool
		// True, if the gift can be transferred to another owner; for gifts received on behalf of
		// business accounts only
		@json("can_be_transferred", omitempty = true)
		canBeTransferred bool
		// Number of Telegram Stars that must be paid to transfer the gift; omitted if the bot
		// cannot transfer the gift
		@json("transfer_star_count", omitempty = true)
		transferStarCount int
		// Point in time (Unix timestamp) when the gift can be transferred.
		@json("next_transfer_date", omitempty = true)
		nextTransferDate int
	}

	// Contains the list of gifts received and owned by a user or a chat.
	struct OwnedGifts {
		// The total number of gifts owned by the user or the chat
		@json("total_count")
		totalCount int
		// The list of gifts
		gifts OwnedGift[]
		// Offset for the next request.
		@json("next_offset", omitempty = true)
		nextOffset string
	}

	// This object describes the access settings of a bot.
	struct BotAccessSettings {
		// True, if only selected users can access the bot.
		@json("is_access_restricted")
		isAccessRestricted bool
		// The list of other users who have access to the bot if the access is restricted
		@json("added_users", omitempty = true)
		addedUsers User[]
	}

	// This object describes the types of gifts that can be gifted to a user or a chat.
	struct AcceptedGiftTypes {
		// True, if unlimited regular gifts are accepted
		@json("unlimited_gifts")
		unlimitedGifts bool
		// True, if limited regular gifts are accepted
		@json("limited_gifts")
		limitedGifts bool
		// True, if unique gifts or gifts that can be upgraded to unique for free are accepted
		@json("unique_gifts")
		uniqueGifts bool
		// True, if a Telegram Premium subscription is accepted
		@json("premium_subscription")
		premiumSubscription bool
		// True, if transfers of unique gifts from channels are accepted
		@json("gifts_from_channels")
		giftsFromChannels bool
	}

	// Describes an amount of Telegram Stars.
	struct StarAmount {
		// Integer amount of Telegram Stars, rounded to 0; can be negative
		amount int
		// The number of 1/1000000000 shares of Telegram Stars; from -999999999 to 999999999; can
		// be negative if and only if amount is non-positive
		@json("nanostar_amount", omitempty = true)
		nanostarAmount int
	}

	// This object represents a bot command.
	struct BotCommand {
		// Text of the command; 1-32 characters.
		command string
		// Description of the command; 1-256 characters
		description string
		// True, if the command sends an ephemeral message, which can be seen only by the sender of
		// the message and the bot
		@json("is_ephemeral", omitempty = true)
		isEphemeral bool
	}

	// This object represents the scope to which bot commands are applied.
	// One struct holds the fields of every kind: BotCommandScopeDefault, BotCommandScopeAllPrivateChats, BotCommandScopeAllGroupChats, BotCommandScopeAllChatAdministrators, BotCommandScopeChat, BotCommandScopeChatAdministrators, BotCommandScopeChatMember.
	struct BotCommandScope {
		// Scope type, must be default
		@json("type", omitempty = true)
		kind string
		// Unique identifier for the target chat or username of the target supergroup in the format
		// @username.
		@json("chat_id", omitempty = true)
		chatId ?any = none
		// Unique identifier of the target user
		@json("user_id", omitempty = true)
		userId int
	}

	// Represents the default scope of bot commands.
	struct BotCommandScopeDefault {
		// Scope type, must be default
		@json("type")
		kind string
	}

	// Represents the scope of bot commands, covering all private chats.
	struct BotCommandScopeAllPrivateChats {
		// Scope type, must be all_private_chats
		@json("type")
		kind string
	}

	// Represents the scope of bot commands, covering all group and supergroup chats.
	struct BotCommandScopeAllGroupChats {
		// Scope type, must be all_group_chats
		@json("type")
		kind string
	}

	// Represents the scope of bot commands, covering all group and supergroup chat
	// administrators.
	struct BotCommandScopeAllChatAdministrators {
		// Scope type, must be all_chat_administrators
		@json("type")
		kind string
	}

	// Represents the scope of bot commands, covering a specific chat.
	struct BotCommandScopeChat {
		// Scope type, must be chat
		@json("type")
		kind string
		// Unique identifier for the target chat or username of the target supergroup in the format
		// @username.
		@json("chat_id")
		chatId any = none
	}

	// Represents the scope of bot commands, covering all administrators of a specific group or
	// supergroup chat.
	struct BotCommandScopeChatAdministrators {
		// Scope type, must be chat_administrators
		@json("type")
		kind string
		// Unique identifier for the target chat or username of the target supergroup in the format
		// @username.
		@json("chat_id")
		chatId any = none
	}

	// Represents the scope of bot commands, covering a specific member of a group or supergroup
	// chat.
	struct BotCommandScopeChatMember {
		// Scope type, must be chat_member
		@json("type")
		kind string
		// Unique identifier for the target chat or username of the target supergroup in the format
		// @username.
		@json("chat_id")
		chatId any = none
		// Unique identifier of the target user
		@json("user_id")
		userId int
	}

	// This object represents the bot's name.
	struct BotName {
		// The bot's name
		name string
	}

	// This object represents the bot's description.
	struct BotDescription {
		// The bot's description
		description string
	}

	// This object represents the bot's short description.
	struct BotShortDescription {
		// The bot's short description
		@json("short_description")
		shortDescription string
	}

	// This object describes the bot's menu button in a private chat.
	// One struct holds the fields of every kind: MenuButtonCommands, MenuButtonWebApp, MenuButtonDefault.
	struct MenuButton {
		// Type of the button, must be commands
		@json("type", omitempty = true)
		kind string
		// Text on the button
		@json(omitempty = true)
		text string
		// Description of the Web App that will be launched when the user presses the button.
		@json("web_app", omitempty = true)
		webApp ?WebAppInfo = none
	}

	// Represents a menu button, which opens the bot's list of commands.
	struct MenuButtonCommands {
		// Type of the button, must be commands
		@json("type")
		kind string
	}

	// Represents a menu button, which launches a Web App.
	struct MenuButtonWebApp {
		// Type of the button, must be web_app
		@json("type")
		kind string
		// Text on the button
		text string
		// Description of the Web App that will be launched when the user presses the button.
		@json("web_app")
		webApp WebAppInfo
	}

	// Describes that no specific value for the menu button was set.
	struct MenuButtonDefault {
		// Type of the button, must be default
		@json("type")
		kind string
	}

	// This object describes the source of a chat boost.
	// One struct holds the fields of every kind: ChatBoostSourcePremium, ChatBoostSourceGiftCode, ChatBoostSourceGiveaway.
	struct ChatBoostSource {
		// Source of the boost, always “premium”
		@json(omitempty = true)
		source string
		// User that boosted the chat
		@json(omitempty = true)
		user ?User = none
		// Identifier of a message in the chat with the giveaway; the message could have been
		// deleted already.
		@json("giveaway_message_id", omitempty = true)
		giveawayMessageId int
		// Optional.
		@json("prize_star_count", omitempty = true)
		prizeStarCount int
		// Optional.
		@json("is_unclaimed", omitempty = true)
		isUnclaimed bool
	}

	// The boost was obtained by subscribing to Telegram Premium or by gifting a Telegram
	// Premium subscription to another user.
	struct ChatBoostSourcePremium {
		// Source of the boost, always “premium”
		source string
		// User that boosted the chat
		user User
	}

	// The boost was obtained by the creation of Telegram Premium gift codes to boost a chat.
	struct ChatBoostSourceGiftCode {
		// Source of the boost, always “gift_code”
		source string
		// User for which the gift code was created
		user User
	}

	// The boost was obtained by the creation of a Telegram Premium or a Telegram Star giveaway.
	struct ChatBoostSourceGiveaway {
		// Source of the boost, always “giveaway”
		source string
		// Identifier of a message in the chat with the giveaway; the message could have been
		// deleted already.
		@json("giveaway_message_id")
		giveawayMessageId int
		// User that won the prize in the giveaway if any; for Telegram Premium giveaways only
		@json(omitempty = true)
		user ?User = none
		// The number of Telegram Stars to be split between giveaway winners; for Telegram Star
		// giveaways only
		@json("prize_star_count", omitempty = true)
		prizeStarCount int
		// True, if the giveaway was completed, but there was no user to win the prize
		@json("is_unclaimed", omitempty = true)
		isUnclaimed bool
	}

	// This object contains information about a chat boost.
	struct ChatBoost {
		// Unique identifier of the boost
		@json("boost_id")
		boostId string
		// Point in time (Unix timestamp) when the chat was boosted
		@json("add_date")
		addDate int
		// Point in time (Unix timestamp) when the boost will automatically expire, unless the
		// booster's Telegram Premium subscription is prolonged
		@json("expiration_date")
		expirationDate int
		// Source of the added boost
		source ChatBoostSource
	}

	// This object represents a boost added to a chat or changed.
	struct ChatBoostUpdated {
		// Chat which was boosted
		chat Chat
		// Information about the chat boost
		boost ChatBoost
	}

	// This object represents a boost removed from a chat.
	struct ChatBoostRemoved {
		// Chat which was boosted
		chat Chat
		// Unique identifier of the boost
		@json("boost_id")
		boostId string
		// Point in time (Unix timestamp) when the boost was removed
		@json("remove_date")
		removeDate int
		// Source of the removed boost
		source ChatBoostSource
	}

	// Describes a service message about the chat owner leaving the chat.
	struct ChatOwnerLeft {
		// The user who will become the new owner of the chat if the previous owner does not return
		// to the chat
		@json("new_owner", omitempty = true)
		newOwner ?User = none
	}

	// Describes a service message about an ownership change in the chat.
	struct ChatOwnerChanged {
		// The new owner of the chat
		@json("new_owner")
		newOwner User
	}

	// This object represents a list of boosts added to a chat by a user.
	struct UserChatBoosts {
		// The list of boosts added to the chat by the user
		boosts ChatBoost[]
	}

	// Represents the rights of a business bot.
	struct BusinessBotRights {
		// True, if the bot can send and edit messages in the private chats that had incoming
		// messages in the last 24 hours
		@json("can_reply", omitempty = true)
		canReply bool
		// True, if the bot can mark incoming private messages as read
		@json("can_read_messages", omitempty = true)
		canReadMessages bool
		// True, if the bot can delete messages sent by the bot
		@json("can_delete_sent_messages", omitempty = true)
		canDeleteSentMessages bool
		// True, if the bot can delete all private messages in managed chats
		@json("can_delete_all_messages", omitempty = true)
		canDeleteAllMessages bool
		// True, if the bot can edit the first and last name of the business account
		@json("can_edit_name", omitempty = true)
		canEditName bool
		// True, if the bot can edit the bio of the business account
		@json("can_edit_bio", omitempty = true)
		canEditBio bool
		// True, if the bot can edit the profile photo of the business account
		@json("can_edit_profile_photo", omitempty = true)
		canEditProfilePhoto bool
		// True, if the bot can edit the username of the business account
		@json("can_edit_username", omitempty = true)
		canEditUsername bool
		// True, if the bot can change the privacy settings pertaining to gifts for the business
		// account
		@json("can_change_gift_settings", omitempty = true)
		canChangeGiftSettings bool
		// True, if the bot can view gifts and the amount of Telegram Stars owned by the business
		// account
		@json("can_view_gifts_and_stars", omitempty = true)
		canViewGiftsAndStars bool
		// True, if the bot can convert regular gifts owned by the business account to Telegram
		// Stars
		@json("can_convert_gifts_to_stars", omitempty = true)
		canConvertGiftsToStars bool
		// True, if the bot can transfer and upgrade gifts owned by the business account
		@json("can_transfer_and_upgrade_gifts", omitempty = true)
		canTransferAndUpgradeGifts bool
		// True, if the bot can transfer Telegram Stars received by the business account to its own
		// account, or use them to upgrade and transfer gifts
		@json("can_transfer_stars", omitempty = true)
		canTransferStars bool
		// True, if the bot can post, edit and delete stories on behalf of the business account
		@json("can_manage_stories", omitempty = true)
		canManageStories bool
	}

	// Describes the connection of the bot with a business account.
	struct BusinessConnection {
		// Unique identifier of the business connection
		id string
		// Business account user that created the business connection
		user User
		// Identifier of a private chat with the user who created the business connection.
		@json("user_chat_id")
		userChatId int
		// Date the connection was established in Unix time
		date int
		// Rights of the business bot
		@json(omitempty = true)
		rights ?BusinessBotRights = none
		// True, if the connection is active
		@json("is_enabled")
		isEnabled bool
	}

	// This object is received when messages are deleted from a connected business account.
	struct BusinessMessagesDeleted {
		// Unique identifier of the business connection
		@json("business_connection_id")
		businessConnectionId string
		// Information about a chat in the business account.
		chat Chat
		// The list of identifiers of deleted messages in the chat of the business account
		@json("message_ids")
		messageIds int[]
	}

	// Describes an inline message sent by a Web App on behalf of a user.
	struct SentWebAppMessage {
		// Identifier of the sent inline message.
		@json("inline_message_id", omitempty = true)
		inlineMessageId string
	}

	// Describes an inline message sent by a guest bot.
	struct SentGuestMessage {
		// Identifier of the sent inline message
		@json("inline_message_id")
		inlineMessageId string
	}

	// Describes an inline message to be sent by a user of a Mini App.
	struct PreparedInlineMessage {
		// Unique identifier of the prepared message
		id string
		// Expiration date of the prepared message, in Unix time.
		@json("expiration_date")
		expirationDate int
	}

	// Describes a keyboard button to be used by a user of a Mini App.
	struct PreparedKeyboardButton {
		// Unique identifier of the keyboard button
		id string
	}

	// Describes why a request was unsuccessful.
	struct ResponseParameters {
		// The group has been migrated to a supergroup with the specified identifier.
		@json("migrate_to_chat_id", omitempty = true)
		migrateToChatId int
		// In case of exceeding flood control, the number of seconds left to wait before the
		// request can be repeated
		@json("retry_after", omitempty = true)
		retryAfter int
	}

	// This object represents the content of a media message to be sent.
	// One struct holds the fields of every kind: InputMediaAnimation, InputMediaAudio, InputMediaDocument, InputMediaLivePhoto, InputMediaPhoto, InputMediaVideo.
	struct InputMedia {
		// Type of the media, must be animation
		@json("type", omitempty = true)
		kind string
		// File to send.
		@json(omitempty = true)
		media ?any = none
		// Optional.
		@json(omitempty = true)
		thumbnail ?any = none
		// Optional.
		@json(omitempty = true)
		caption string
		// Optional.
		@json("parse_mode", omitempty = true)
		parseMode string
		// Optional.
		@json("caption_entities", omitempty = true)
		captionEntities MessageEntity[]
		// Optional.
		@json("show_caption_above_media", omitempty = true)
		showCaptionAboveMedia bool
		// Optional.
		@json(omitempty = true)
		width int
		// Optional.
		@json(omitempty = true)
		height int
		// Optional.
		@json(omitempty = true)
		duration int
		// Optional.
		@json("has_spoiler", omitempty = true)
		hasSpoiler bool
		// Optional.
		@json(omitempty = true)
		performer string
		// Optional.
		@json(omitempty = true)
		title string
		// Optional.
		@json("disable_content_type_detection", omitempty = true)
		disableContentTypeDetection bool
		// The static photo to send.
		@json(omitempty = true)
		photo ?any = none
		// Optional.
		@json(omitempty = true)
		cover ?any = none
		// Optional.
		@json("start_timestamp", omitempty = true)
		startTimestamp int
		// Optional.
		@json("supports_streaming", omitempty = true)
		supportsStreaming bool
	}

	// Represents an animation file (GIF or H.264/MPEG-4 AVC video without sound) to be sent.
	struct InputMediaAnimation {
		// Type of the media, must be animation
		@json("type")
		kind string
		// File to send.
		media any = none
		// Thumbnail of the file sent; can be ignored if thumbnail generation for the file is
		// supported server-side.
		@json(omitempty = true)
		thumbnail ?any = none
		// Caption of the animation to be sent, 0-1024 characters after entities parsing
		@json(omitempty = true)
		caption string
		// Mode for parsing entities in the animation caption.
		@json("parse_mode", omitempty = true)
		parseMode string
		// List of special entities that appear in the caption, which can be specified instead of
		// parse_mode
		@json("caption_entities", omitempty = true)
		captionEntities MessageEntity[]
		// Pass True if the caption must be shown above the message media
		@json("show_caption_above_media", omitempty = true)
		showCaptionAboveMedia bool
		// Animation width
		@json(omitempty = true)
		width int
		// Animation height
		@json(omitempty = true)
		height int
		// Animation duration in seconds
		@json(omitempty = true)
		duration int
		// Pass True if the animation needs to be covered with a spoiler animation
		@json("has_spoiler", omitempty = true)
		hasSpoiler bool
	}

	// Represents an audio file to be treated as music to be sent.
	struct InputMediaAudio {
		// Type of the media, must be audio
		@json("type")
		kind string
		// File to send.
		media any = none
		// Thumbnail of the file sent; can be ignored if thumbnail generation for the file is
		// supported server-side.
		@json(omitempty = true)
		thumbnail ?any = none
		// Caption of the audio to be sent, 0-1024 characters after entities parsing
		@json(omitempty = true)
		caption string
		// Mode for parsing entities in the audio caption.
		@json("parse_mode", omitempty = true)
		parseMode string
		// List of special entities that appear in the caption, which can be specified instead of
		// parse_mode
		@json("caption_entities", omitempty = true)
		captionEntities MessageEntity[]
		// Duration of the audio in seconds
		@json(omitempty = true)
		duration int
		// Performer of the audio
		@json(omitempty = true)
		performer string
		// Title of the audio
		@json(omitempty = true)
		title string
	}

	// Represents a general file to be sent.
	struct InputMediaDocument {
		// Type of the media, must be document
		@json("type")
		kind string
		// File to send.
		media any = none
		// Thumbnail of the file sent; can be ignored if thumbnail generation for the file is
		// supported server-side.
		@json(omitempty = true)
		thumbnail ?any = none
		// Caption of the document to be sent, 0-1024 characters after entities parsing
		@json(omitempty = true)
		caption string
		// Mode for parsing entities in the document caption.
		@json("parse_mode", omitempty = true)
		parseMode string
		// List of special entities that appear in the caption, which can be specified instead of
		// parse_mode
		@json("caption_entities", omitempty = true)
		captionEntities MessageEntity[]
		// Disables automatic server-side content type detection for files uploaded using
		// multipart/form-data.
		@json("disable_content_type_detection", omitempty = true)
		disableContentTypeDetection bool
	}

	// Represents an HTTP link to be sent.
	struct InputMediaLink {
		// Type of the media, must be link
		@json("type")
		kind string
		// HTTP URL of the link
		url string
	}

	// Represents a live photo to be sent.
	struct InputMediaLivePhoto {
		// Type of the media, must be live_photo
		@json("type")
		kind string
		// Video of the live photo to send.
		media any = none
		// The static photo to send.
		photo any = none
		// Caption of the live photo to be sent, 0-1024 characters after entities parsing
		@json(omitempty = true)
		caption string
		// Mode for parsing entities in the live photo caption.
		@json("parse_mode", omitempty = true)
		parseMode string
		// List of special entities that appear in the caption, which can be specified instead of
		// parse_mode
		@json("caption_entities", omitempty = true)
		captionEntities MessageEntity[]
		// Pass True if the caption must be shown above the message media
		@json("show_caption_above_media", omitempty = true)
		showCaptionAboveMedia bool
		// Pass True if the live photo needs to be covered with a spoiler animation
		@json("has_spoiler", omitempty = true)
		hasSpoiler bool
	}

	// Represents a location to be sent.
	struct InputMediaLocation {
		// Type of the media, must be location
		@json("type")
		kind string
		// Latitude of the location
		latitude float
		// Longitude of the location
		longitude float
		// The radius of uncertainty for the location, measured in meters; 0-1500
		@json("horizontal_accuracy", omitempty = true)
		horizontalAccuracy float
	}

	// Represents a photo to be sent.
	struct InputMediaPhoto {
		// Type of the media, must be photo
		@json("type")
		kind string
		// File to send.
		media any = none
		// Caption of the photo to be sent, 0-1024 characters after entities parsing
		@json(omitempty = true)
		caption string
		// Mode for parsing entities in the photo caption.
		@json("parse_mode", omitempty = true)
		parseMode string
		// List of special entities that appear in the caption, which can be specified instead of
		// parse_mode
		@json("caption_entities", omitempty = true)
		captionEntities MessageEntity[]
		// Pass True if the caption must be shown above the message media
		@json("show_caption_above_media", omitempty = true)
		showCaptionAboveMedia bool
		// Pass True if the photo needs to be covered with a spoiler animation
		@json("has_spoiler", omitempty = true)
		hasSpoiler bool
	}

	// Represents a sticker file to be sent.
	struct InputMediaSticker {
		// Type of the media, must be sticker
		@json("type")
		kind string
		// File to send.
		media any = none
		// Emoji associated with the sticker; only for just uploaded stickers
		@json(omitempty = true)
		emoji string
	}

	// Represents a venue to be sent.
	struct InputMediaVenue {
		// Type of the media, must be venue
		@json("type")
		kind string
		// Latitude of the location
		latitude float
		// Longitude of the location
		longitude float
		// Name of the venue
		title string
		// Address of the venue
		address string
		// Foursquare identifier of the venue
		@json("foursquare_id", omitempty = true)
		foursquareId string
		// Foursquare type of the venue, if known.
		@json("foursquare_type", omitempty = true)
		foursquareType string
		// Google Places identifier of the venue
		@json("google_place_id", omitempty = true)
		googlePlaceId string
		// Google Places type of the venue.
		@json("google_place_type", omitempty = true)
		googlePlaceType string
	}

	// Represents a video to be sent.
	struct InputMediaVideo {
		// Type of the media, must be video
		@json("type")
		kind string
		// File to send.
		media any = none
		// Thumbnail of the file sent; can be ignored if thumbnail generation for the file is
		// supported server-side.
		@json(omitempty = true)
