	// This object represents the content of a message to be sent as a result of an inline
	// query.
	// One struct holds the fields of every kind: InputTextMessageContent, InputRichMessageContent, InputLocationMessageContent, InputVenueMessageContent, InputContactMessageContent, InputInvoiceMessageContent.
	struct InputMessageContent {
		// Text of the message to be sent, 1-4096 characters
		@json("message_text", omitempty = true)
		messageText string
		// Optional.
		@json("parse_mode", omitempty = true)
		parseMode string
		// Optional.
		@json(omitempty = true)
		entities MessageEntity[]
		// Optional.
		@json("link_preview_options", omitempty = true)
		linkPreviewOptions ?LinkPreviewOptions = none
		// The message to be sent.
		@json("rich_message", omitempty = true)
		richMessage ?InputRichMessage = none
		// Latitude of the location in degrees
		@json(omitempty = true)
		latitude float
		// Longitude of the location in degrees
		@json(omitempty = true)
		longitude float
		// Optional.
		@json("horizontal_accuracy", omitempty = true)
		horizontalAccuracy float
		// Optional.
		@json("live_period", omitempty = true)
		livePeriod int
		// Optional.
		@json(omitempty = true)
		heading int
		// Optional.
		@json("proximity_alert_radius", omitempty = true)
		proximityAlertRadius int
		// Name of the venue
		@json(omitempty = true)
		title string
		// Address of the venue
		@json(omitempty = true)
		address string
		// Optional.
		@json("foursquare_id", omitempty = true)
		foursquareId string
		// Optional.
		@json("foursquare_type", omitempty = true)
		foursquareType string
		// Optional.
		@json("google_place_id", omitempty = true)
		googlePlaceId string
		// Optional.
		@json("google_place_type", omitempty = true)
		googlePlaceType string
		// Contact's phone number
		@json("phone_number", omitempty = true)
		phoneNumber string
		// Contact's first name
		@json("first_name", omitempty = true)
		firstName string
		// Optional.
		@json("last_name", omitempty = true)
		lastName string
		// Optional.
		@json(omitempty = true)
		vcard string
		// Product description, 1-255 characters
		@json(omitempty = true)
		description string
		// Bot-defined invoice payload, 1-128 bytes.
		@json(omitempty = true)
		payload string
		// Optional.
		@json("provider_token", omitempty = true)
		providerToken string
		// Three-letter ISO 4217 currency code, see more on currencies.
		@json(omitempty = true)
		currency string
		// Price breakdown, a JSON-serialized list of components (e.g.
		@json(omitempty = true)
		prices LabeledPrice[]
		// Optional.
		@json("max_tip_amount", omitempty = true)
		maxTipAmount int
		// Optional.
		@json("suggested_tip_amounts", omitempty = true)
		suggestedTipAmounts int[]
		// Optional.
		@json("provider_data", omitempty = true)
		providerData string
		// Optional.
		@json("photo_url", omitempty = true)
		photoUrl string
		// Optional.
		@json("photo_size", omitempty = true)
		photoSize int
		// Optional.
		@json("photo_width", omitempty = true)
		photoWidth int
		// Optional.
		@json("photo_height", omitempty = true)
		photoHeight int
		// Optional.
		@json("need_name", omitempty = true)
		needName bool
		// Optional.
		@json("need_phone_number", omitempty = true)
		needPhoneNumber bool
		// Optional.
		@json("need_email", omitempty = true)
		needEmail bool
		// Optional.
		@json("need_shipping_address", omitempty = true)
		needShippingAddress bool
		// Optional.
		@json("send_phone_number_to_provider", omitempty = true)
		sendPhoneNumberToProvider bool
		// Optional.
		@json("send_email_to_provider", omitempty = true)
		sendEmailToProvider bool
		// Optional.
		@json("is_flexible", omitempty = true)
		isFlexible bool
	}

	// Represents the content of a text message to be sent as the result of an inline query.
	struct InputTextMessageContent {
		// Text of the message to be sent, 1-4096 characters
		@json("message_text")
		messageText string
		// Mode for parsing entities in the message text.
		@json("parse_mode", omitempty = true)
		parseMode string
		// List of special entities that appear in message text, which can be specified instead of
		// parse_mode
		@json(omitempty = true)
		entities MessageEntity[]
		// Link preview generation options for the message
		@json("link_preview_options", omitempty = true)
		linkPreviewOptions ?LinkPreviewOptions = none
	}

	// Represents the content of a rich message to be sent as the result of an inline query.
	struct InputRichMessageContent {
		// The message to be sent.
		@json("rich_message")
		richMessage InputRichMessage
	}

	// Represents the content of a location message to be sent as the result of an inline query.
	struct InputLocationMessageContent {
		// Latitude of the location in degrees
		latitude float
		// Longitude of the location in degrees
		longitude float
		// The radius of uncertainty for the location, measured in meters; 0-1500
		@json("horizontal_accuracy", omitempty = true)
		horizontalAccuracy float
		// Period in seconds during which the location can be updated, must be between 60 and
		// 86400, or 0x7FFFFFFF for live locations that can be edited indefinitely
		@json("live_period", omitempty = true)
		livePeriod int
		// For live locations, a direction in which the user is moving, in degrees.
		@json(omitempty = true)
		heading int
		// For live locations, a maximum distance for proximity alerts about approaching another
		// chat member, in meters.
		@json("proximity_alert_radius", omitempty = true)
		proximityAlertRadius int
	}

	// Represents the content of a venue message to be sent as the result of an inline query.
	struct InputVenueMessageContent {
		// Latitude of the venue in degrees
		latitude float
		// Longitude of the venue in degrees
		longitude float
		// Name of the venue
		title string
		// Address of the venue
		address string
		// Foursquare identifier of the venue, if known
		@json("foursquare_id", omitempty = true)
		foursquareId string
		// Foursquare type of the venue, if known.
		@json("foursquare_type", omitempty = true)
		foursquareType string
		// Google Places identifier of the venue
		@json("google_place_id", omitempty = true)
		googlePlaceId string
		// Google Places type of the venue.
		@json("google_place_type", omitempty = true)
		googlePlaceType string
	}

	// Represents the content of a contact message to be sent as the result of an inline query.
	struct InputContactMessageContent {
		// Contact's phone number
		@json("phone_number")
		phoneNumber string
		// Contact's first name
		@json("first_name")
		firstName string
		// Contact's last name
		@json("last_name", omitempty = true)
		lastName string
		// Additional data about the contact in the form of a vCard, 0-2048 bytes
		@json(omitempty = true)
		vcard string
	}

	// Represents the content of an invoice message to be sent as the result of an inline query.
	struct InputInvoiceMessageContent {
		// Product name, 1-32 characters
		title string
		// Product description, 1-255 characters
		description string
		// Bot-defined invoice payload, 1-128 bytes.
		payload string
		// Payment provider token, obtained via @BotFather.
		@json("provider_token", omitempty = true)
		providerToken string
		// Three-letter ISO 4217 currency code, see more on currencies.
		currency string
		// Price breakdown, a JSON-serialized list of components (e.g.
		prices LabeledPrice[]
		// The maximum accepted amount for tips in the smallest units of the currency (integer, not
		// float/double).
		@json("max_tip_amount", omitempty = true)
		maxTipAmount int
		// A JSON-serialized Array of suggested amounts of tip in the smallest units of the
		// currency (integer, not float/double).
		@json("suggested_tip_amounts", omitempty = true)
		suggestedTipAmounts int[]
		// A JSON-serialized object for data about the invoice, which will be shared with the
		// payment provider.
		@json("provider_data", omitempty = true)
		providerData string
		// URL of the product photo for the invoice.
		@json("photo_url", omitempty = true)
		photoUrl string
		// Photo size in bytes
		@json("photo_size", omitempty = true)
		photoSize int
		// Photo width
		@json("photo_width", omitempty = true)
		photoWidth int
		// Photo height
		@json("photo_height", omitempty = true)
		photoHeight int
		// Pass True if you require the user's full name to complete the order.
		@json("need_name", omitempty = true)
		needName bool
		// Pass True if you require the user's phone number to complete the order.
		@json("need_phone_number", omitempty = true)
		needPhoneNumber bool
		// Pass True if you require the user's email address to complete the order.
		@json("need_email", omitempty = true)
		needEmail bool
		// Pass True if you require the user's shipping address to complete the order.
		@json("need_shipping_address", omitempty = true)
		needShippingAddress bool
		// Pass True if the user's phone number should be sent to the provider.
		@json("send_phone_number_to_provider", omitempty = true)
		sendPhoneNumberToProvider bool
		// Pass True if the user's email address should be sent to the provider.
		@json("send_email_to_provider", omitempty = true)
		sendEmailToProvider bool
		// Pass True if the final price depends on the shipping method.
		@json("is_flexible", omitempty = true)
		isFlexible bool
	}

	// Represents a result of an inline query that was chosen by the user and sent to their chat
	// partner.
	struct ChosenInlineResult {
		// The unique identifier for the result that was chosen
		@json("result_id")
		resultId string
		// The user that chose the result
		from User
		// Sender location, only for bots that require user location
		@json(omitempty = true)
		location ?Location = none
		// Identifier of the sent inline message.
		@json("inline_message_id", omitempty = true)
		inlineMessageId string
		// The query that was used to obtain the result
		query string
	}

	// This object represents a portion of the price for goods or services.
	struct LabeledPrice {
		// Portion label
		label string
		// Price of the product in the smallest units of the currency (integer, not float/double).
		amount int
	}

	// This object contains basic information about an invoice.
	struct Invoice {
		// Product name
		title string
		// Product description
		description string
		// Unique bot deep-linking parameter that can be used to generate this invoice
		@json("start_parameter")
		startParameter string
		// Three-letter ISO 4217 currency code, or “XTR” for payments in Telegram Stars
		currency string
		// Total price in the smallest units of the currency (integer, not float/double).
		@json("total_amount")
		totalAmount int
	}

	// This object represents a shipping address.
	struct ShippingAddress {
		// Two-letter ISO 3166-1 alpha-2 country code
		@json("country_code")
		countryCode string
		// State, if applicable
		state string
		// City
		city string
		// First line for the address
		@json("street_line1")
		streetLine1 string
		// Second line for the address
		@json("street_line2")
		streetLine2 string
		// Address post code
		@json("post_code")
		postCode string
	}

	// This object represents information about an order.
	struct OrderInfo {
		// User name
		@json(omitempty = true)
		name string
		// User's phone number
		@json("phone_number", omitempty = true)
		phoneNumber string
		// User email
		@json(omitempty = true)
		email string
		// User shipping address
		@json("shipping_address", omitempty = true)
		shippingAddress ?ShippingAddress = none
	}

	// This object represents one shipping option.
	struct ShippingOption {
		// Shipping option identifier
		id string
		// Option title
		title string
		// List of price portions
		prices LabeledPrice[]
	}

	// This object contains basic information about a successful payment.
	struct SuccessfulPayment {
		// Three-letter ISO 4217 currency code, or “XTR” for payments in Telegram Stars
		currency string
		// Total price in the smallest units of the currency (integer, not float/double).
		@json("total_amount")
		totalAmount int
		// Bot-specified invoice payload
		@json("invoice_payload")
		invoicePayload string
		// Expiration date of the subscription, in Unix time; for recurring payments only
		@json("subscription_expiration_date", omitempty = true)
		subscriptionExpirationDate int
		// True, if the payment is a recurring payment for a subscription
		@json("is_recurring", omitempty = true)
		isRecurring bool
		// True, if the payment is the first payment for a subscription
		@json("is_first_recurring", omitempty = true)
		isFirstRecurring bool
		// Identifier of the shipping option chosen by the user
		@json("shipping_option_id", omitempty = true)
		shippingOptionId string
		// Order information provided by the user
		@json("order_info", omitempty = true)
		orderInfo ?OrderInfo = none
		// Telegram payment identifier
		@json("telegram_payment_charge_id")
		telegramPaymentChargeId string
		// Provider payment identifier
		@json("provider_payment_charge_id")
		providerPaymentChargeId string
	}

	// This object contains basic information about a refunded payment.
	struct RefundedPayment {
		// Three-letter ISO 4217 currency code, or “XTR” for payments in Telegram Stars.
		currency string
		// Total refunded price in the smallest units of the currency (integer, not float/double).
		@json("total_amount")
		totalAmount int
		// Bot-specified invoice payload
		@json("invoice_payload")
		invoicePayload string
		// Telegram payment identifier
		@json("telegram_payment_charge_id")
		telegramPaymentChargeId string
		// Provider payment identifier
		@json("provider_payment_charge_id", omitempty = true)
		providerPaymentChargeId string
	}

	// This object contains information about an incoming shipping query.
	struct ShippingQuery {
		// Unique query identifier
		id string
		// User who sent the query
		from User
		// Bot-specified invoice payload
		@json("invoice_payload")
		invoicePayload string
		// User specified shipping address
		@json("shipping_address")
		shippingAddress ShippingAddress
	}

	// This object contains information about an incoming pre-checkout query.
	struct PreCheckoutQuery {
		// Unique query identifier
		id string
		// User who sent the query
		from User
		// Three-letter ISO 4217 currency code, or “XTR” for payments in Telegram Stars
		currency string
		// Total price in the smallest units of the currency (integer, not float/double).
		@json("total_amount")
		totalAmount int
		// Bot-specified invoice payload
		@json("invoice_payload")
		invoicePayload string
		// Identifier of the shipping option chosen by the user
		@json("shipping_option_id", omitempty = true)
		shippingOptionId string
		// Order information provided by the user
		@json("order_info", omitempty = true)
		orderInfo ?OrderInfo = none
	}

	// This object contains information about a paid media purchase.
	struct PaidMediaPurchased {
		// User who purchased the media
		from User
		// Bot-specified paid media payload
		@json("paid_media_payload")
		paidMediaPayload string
	}

	// This object describes the state of a revenue withdrawal operation.
	// One struct holds the fields of every kind: RevenueWithdrawalStatePending, RevenueWithdrawalStateSucceeded, RevenueWithdrawalStateFailed.
	struct RevenueWithdrawalState {
		// Type of the state, always “pending”
		@json("type", omitempty = true)
		kind string
		// Date the withdrawal was completed in Unix time
		@json(omitempty = true)
		date int
		// An HTTPS URL that can be used to see transaction details
		@json(omitempty = true)
		url string
	}

	// The withdrawal is in progress.
	struct RevenueWithdrawalStatePending {
		// Type of the state, always “pending”
		@json("type")
		kind string
	}

	// The withdrawal succeeded.
	struct RevenueWithdrawalStateSucceeded {
		// Type of the state, always “succeeded”
		@json("type")
		kind string
		// Date the withdrawal was completed in Unix time
		date int
		// An HTTPS URL that can be used to see transaction details
		url string
	}

	// The withdrawal failed and the transaction was refunded.
	struct RevenueWithdrawalStateFailed {
		// Type of the state, always “failed”
		@json("type")
		kind string
	}

	// Contains information about the affiliate that received a commission via this transaction.
	struct AffiliateInfo {
		// The bot or the user that received an affiliate commission if it was received by a bot or
		// a user
		@json("affiliate_user", omitempty = true)
		affiliateUser ?User = none
		// The chat that received an affiliate commission if it was received by a chat
		@json("affiliate_chat", omitempty = true)
		affiliateChat ?Chat = none
		// The number of Telegram Stars received by the affiliate for each 1000 Telegram Stars
		// received by the bot from referred users
		@json("commission_per_mille")
		commissionPerMille int
		// Integer amount of Telegram Stars received by the affiliate from the transaction, rounded
		// to 0; can be negative for refunds
		amount int
		// The number of 1/1000000000 shares of Telegram Stars received by the affiliate; from
		// -999999999 to 999999999; can be negative for refunds
		@json("nanostar_amount", omitempty = true)
		nanostarAmount int
	}

	// This object describes the source of a transaction, or its recipient for outgoing
	// transactions.
	// One struct holds the fields of every kind: TransactionPartnerUser, TransactionPartnerChat, TransactionPartnerAffiliateProgram, TransactionPartnerFragment, TransactionPartnerTelegramAds, TransactionPartnerTelegramApi, TransactionPartnerOther.
	struct TransactionPartner {
		// Type of the transaction partner, always “user”
		@json("type", omitempty = true)
		kind string
		// Type of the transaction, currently one of “invoice_payment” for payments via invoices,
		// “paid_media_payment” for payments for paid media, “gift_purchase” for gifts sent by the
		// bot, “premium_purchase” for Telegram Premium subscriptions gifted by the bot,
		// “business_account_transfer” for direct transfers from managed business accounts
		@json("transaction_type", omitempty = true)
		transactionType string
		// Information about the user
		@json(omitempty = true)
		user ?User = none
		// Optional.
		@json(omitempty = true)
		affiliate ?AffiliateInfo = none
		// Optional.
		@json("invoice_payload", omitempty = true)
		invoicePayload string
		// Optional.
		@json("subscription_period", omitempty = true)
		subscriptionPeriod int
		// Optional.
		@json("paid_media", omitempty = true)
		paidMedia PaidMedia[]
		// Optional.
		@json("paid_media_payload", omitempty = true)
		paidMediaPayload string
		// Optional.
		@json(omitempty = true)
		gift ?Gift = none
		// Optional.
		@json("premium_subscription_duration", omitempty = true)
		premiumSubscriptionDuration int
		// Information about the chat
		@json(omitempty = true)
		chat ?Chat = none
		// Optional.
		@json("sponsor_user", omitempty = true)
		sponsorUser ?User = none
		// The number of Telegram Stars received by the bot for each 1000 Telegram Stars received
		// by the affiliate program sponsor from referred users
		@json("commission_per_mille", omitempty = true)
		commissionPerMille int
		// Optional.
		@json("withdrawal_state", omitempty = true)
		withdrawalState ?RevenueWithdrawalState = none
		// The number of successful requests that exceeded regular limits and were therefore billed
		@json("request_count", omitempty = true)
		requestCount int
	}

	// Describes a transaction with a user.
	struct TransactionPartnerUser {
		// Type of the transaction partner, always “user”
		@json("type")
		kind string
		// Type of the transaction, currently one of “invoice_payment” for payments via invoices,
		// “paid_media_payment” for payments for paid media, “gift_purchase” for gifts sent by the
		// bot, “premium_purchase” for Telegram Premium subscriptions gifted by the bot,
		// “business_account_transfer” for direct transfers from managed business accounts
		@json("transaction_type")
		transactionType string
		// Information about the user
		user User
		// Information about the affiliate that received a commission via this transaction.
		@json(omitempty = true)
		affiliate ?AffiliateInfo = none
		// Bot-specified invoice payload.
		@json("invoice_payload", omitempty = true)
		invoicePayload string
		// The duration of the paid subscription.
		@json("subscription_period", omitempty = true)
		subscriptionPeriod int
		// Information about the paid media bought by the user; for “paid_media_payment”
		// transactions only
		@json("paid_media", omitempty = true)
		paidMedia PaidMedia[]
		// Bot-specified paid media payload.
		@json("paid_media_payload", omitempty = true)
		paidMediaPayload string
		// The gift sent to the user by the bot; for “gift_purchase” transactions only
		@json(omitempty = true)
		gift ?Gift = none
		// Number of months the gifted Telegram Premium subscription will be active for; for
		// “premium_purchase” transactions only
		@json("premium_subscription_duration", omitempty = true)
		premiumSubscriptionDuration int
	}

	// Describes a transaction with a chat.
	struct TransactionPartnerChat {
		// Type of the transaction partner, always “chat”
		@json("type")
		kind string
		// Information about the chat
		chat Chat
		// The gift sent to the chat by the bot
		@json(omitempty = true)
		gift ?Gift = none
	}

	// Describes the affiliate program that issued the affiliate commission received via this
	// transaction.
	struct TransactionPartnerAffiliateProgram {
		// Type of the transaction partner, always “affiliate_program”
		@json("type")
		kind string
		// Information about the bot that sponsored the affiliate program
		@json("sponsor_user", omitempty = true)
		sponsorUser ?User = none
		// The number of Telegram Stars received by the bot for each 1000 Telegram Stars received
		// by the affiliate program sponsor from referred users
		@json("commission_per_mille")
		commissionPerMille int
	}

	// Describes a withdrawal transaction with Fragment.
	struct TransactionPartnerFragment {
		// Type of the transaction partner, always “fragment”
		@json("type")
		kind string
		// State of the transaction if the transaction is outgoing
		@json("withdrawal_state", omitempty = true)
		withdrawalState ?RevenueWithdrawalState = none
	}

	// Describes a withdrawal transaction to the Telegram Ads platform.
	struct TransactionPartnerTelegramAds {
		// Type of the transaction partner, always “telegram_ads”
		@json("type")
		kind string
	}

	// Describes a transaction with payment for paid broadcasting.
	struct TransactionPartnerTelegramApi {
		// Type of the transaction partner, always “telegram_api”
		@json("type")
		kind string
		// The number of successful requests that exceeded regular limits and were therefore billed
		@json("request_count")
		requestCount int
	}

	// Describes a transaction with an unknown source or recipient.
	struct TransactionPartnerOther {
		// Type of the transaction partner, always “other”
		@json("type")
		kind string
	}

	// Describes a Telegram Star transaction.
	struct StarTransaction {
		// Unique identifier of the transaction.
		id string
		// Integer amount of Telegram Stars transferred by the transaction
		amount int
		// The number of 1/1000000000 shares of Telegram Stars transferred by the transaction; from
		// 0 to 999999999
		@json("nanostar_amount", omitempty = true)
		nanostarAmount int
		// Date the transaction was created in Unix time
		date int
		// Source of an incoming transaction (e.g., a user purchasing goods or services, Fragment
		// refunding a failed withdrawal).
		@json(omitempty = true)
		source ?TransactionPartner = none
		// Receiver of an outgoing transaction (e.g., a user for a purchase refund, Fragment for a
		// withdrawal).
		@json(omitempty = true)
		receiver ?TransactionPartner = none
	}

	// Contains a list of Telegram Star transactions.
	struct StarTransactions {
		// The list of transactions
		transactions StarTransaction[]
	}

	// Describes Telegram Passport data shared with the bot by the user.
	struct PassportData {
		// Array with information about documents and other Telegram Passport elements that was
		// shared with the bot
		data EncryptedPassportElement[]
		// Encrypted credentials required to decrypt the data
		credentials EncryptedCredentials
	}

	// This object represents a file uploaded to Telegram Passport.
	struct PassportFile {
		// Identifier for this file, which can be used to download or reuse the file
		@json("file_id")
		fileId string
		// Unique identifier for this file, which is supposed to be the same over time and for
		// different bots.
		@json("file_unique_id")
		fileUniqueId string
		// File size in bytes
		@json("file_size")
		fileSize int
		// Unix time when the file was uploaded
		@json("file_date")
		fileDate int
	}

	// Describes documents or other Telegram Passport elements shared with the bot by the user.
	struct EncryptedPassportElement {
		// Element type.
		@json("type")
		kind string
		// Base64-encoded encrypted Telegram Passport element data provided by the user; available
		// only for “personal_details”, “passport”, “driver_license”, “identity_card”,
		// “internal_passport” and “address” types.
		@json(omitempty = true)
		data string
		// User's verified phone number; available only for “phone_number” type
		@json("phone_number", omitempty = true)
		phoneNumber string
		// User's verified email address; available only for “email” type
		@json(omitempty = true)
		email string
		// Array of encrypted files with documents provided by the user; available only for
		// “utility_bill”, “bank_statement”, “rental_agreement”, “passport_registration” and
		// “temporary_registration” types.
		@json(omitempty = true)
		files PassportFile[]
		// Encrypted file with the front side of the document, provided by the user; available only
		// for “passport”, “driver_license”, “identity_card” and “internal_passport”.
		@json("front_side", omitempty = true)
		frontSide ?PassportFile = none
		// Encrypted file with the reverse side of the document, provided by the user; available
		// only for “driver_license” and “identity_card”.
		@json("reverse_side", omitempty = true)
		reverseSide ?PassportFile = none
		// Encrypted file with the selfie of the user holding a document, provided by the user;
		// available if requested for “passport”, “driver_license”, “identity_card” and
		// “internal_passport”.
		@json(omitempty = true)
		selfie ?PassportFile = none
		// Array of encrypted files with translated versions of documents provided by the user;
		// available if requested for “passport”, “driver_license”, “identity_card”,
		// “internal_passport”, “utility_bill”, “bank_statement”, “rental_agreement”,
		// “passport_registration” and “temporary_registration” types.
		@json(omitempty = true)
		translation PassportFile[]
		// Base64-encoded element hash for using in PassportElementErrorUnspecified
		hash string
	}

	// Describes data required for decrypting and authenticating EncryptedPassportElement.
	struct EncryptedCredentials {
		// Base64-encoded encrypted JSON-serialized data with unique user's payload, data hashes
		// and secrets required for EncryptedPassportElement decryption and authentication
		data string
		// Base64-encoded data hash for data authentication
		hash string
		// Base64-encoded secret, encrypted with the bot's public RSA key, required for data
		// decryption
		secret string
	}

	// This object represents an error in the Telegram Passport element which was submitted that
	// should be resolved by the user.
	// One struct holds the fields of every kind: PassportElementErrorDataField, PassportElementErrorFrontSide, PassportElementErrorReverseSide, PassportElementErrorSelfie, PassportElementErrorFile, PassportElementErrorFiles, PassportElementErrorTranslationFile, PassportElementErrorTranslationFiles, PassportElementErrorUnspecified.
	struct PassportElementError {
		// Error source, must be data
		@json(omitempty = true)
		source string
		// The section of the user's Telegram Passport which has the error, one of
		// “personal_details”, “passport”, “driver_license”, “identity_card”, “internal_passport”,
		// “address”
		@json("type", omitempty = true)
		kind string
		// Name of the data field which has the error
		@json("field_name", omitempty = true)
		fieldName string
		// Base64-encoded data hash
		@json("data_hash", omitempty = true)
		dataHash string
		// Error message
		@json(omitempty = true)
		message string
		// Base64-encoded hash of the file with the front side of the document
		@json("file_hash", omitempty = true)
		fileHash string
		// List of base64-encoded file hashes
		@json("file_hashes", omitempty = true)
		fileHashes string[]
		// Base64-encoded element hash
		@json("element_hash", omitempty = true)
		elementHash string
	}

	// Represents an issue in one of the data fields that was provided by the user.
	struct PassportElementErrorDataField {
		// Error source, must be data
		source string
		// The section of the user's Telegram Passport which has the error, one of
		// “personal_details”, “passport”, “driver_license”, “identity_card”, “internal_passport”,
		// “address”
		@json("type")
		kind string
		// Name of the data field which has the error
		@json("field_name")
		fieldName string
		// Base64-encoded data hash
		@json("data_hash")
		dataHash string
		// Error message
		message string
	}

	// Represents an issue with the front side of a document.
	struct PassportElementErrorFrontSide {
		// Error source, must be front_side
		source string
		// The section of the user's Telegram Passport which has the issue, one of “passport”,
		// “driver_license”, “identity_card”, “internal_passport”
		@json("type")
		kind string
		// Base64-encoded hash of the file with the front side of the document
		@json("file_hash")
		fileHash string
		// Error message
		message string
	}

	// Represents an issue with the reverse side of a document.
	struct PassportElementErrorReverseSide {
		// Error source, must be reverse_side
		source string
		// The section of the user's Telegram Passport which has the issue, one of
		// “driver_license”, “identity_card”
		@json("type")
		kind string
		// Base64-encoded hash of the file with the reverse side of the document
		@json("file_hash")
		fileHash string
		// Error message
		message string
	}

	// Represents an issue with the selfie with a document.
	struct PassportElementErrorSelfie {
		// Error source, must be selfie
		source string
		// The section of the user's Telegram Passport which has the issue, one of “passport”,
		// “driver_license”, “identity_card”, “internal_passport”
		@json("type")
		kind string
		// Base64-encoded hash of the file with the selfie
		@json("file_hash")
		fileHash string
		// Error message
		message string
	}

	// Represents an issue with a document scan.
	struct PassportElementErrorFile {
		// Error source, must be file
		source string
		// The section of the user's Telegram Passport which has the issue, one of “utility_bill”,
		// “bank_statement”, “rental_agreement”, “passport_registration”, “temporary_registration”
		@json("type")
		kind string
		// Base64-encoded file hash
		@json("file_hash")
		fileHash string
		// Error message
		message string
	}

	// Represents an issue with a list of scans.
	struct PassportElementErrorFiles {
		// Error source, must be files
		source string
		// The section of the user's Telegram Passport which has the issue, one of “utility_bill”,
		// “bank_statement”, “rental_agreement”, “passport_registration”, “temporary_registration”
		@json("type")
		kind string
		// List of base64-encoded file hashes
		@json("file_hashes")
		fileHashes string[]
		// Error message
		message string
	}

	// Represents an issue with one of the files that constitute the translation of a document.
	struct PassportElementErrorTranslationFile {
		// Error source, must be translation_file
		source string
		// Type of element of the user's Telegram Passport which has the issue, one of “passport”,
		// “driver_license”, “identity_card”, “internal_passport”, “utility_bill”,
		// “bank_statement”, “rental_agreement”, “passport_registration”, “temporary_registration”
		@json("type")
		kind string
		// Base64-encoded file hash
		@json("file_hash")
		fileHash string
		// Error message
		message string
	}

	// Represents an issue with the translated version of a document.
	struct PassportElementErrorTranslationFiles {
		// Error source, must be translation_files
		source string
		// Type of element of the user's Telegram Passport which has the issue, one of “passport”,
		// “driver_license”, “identity_card”, “internal_passport”, “utility_bill”,
		// “bank_statement”, “rental_agreement”, “passport_registration”, “temporary_registration”
		@json("type")
		kind string
		// List of base64-encoded file hashes
		@json("file_hashes")
		fileHashes string[]
		// Error message
		message string
	}

	// Represents an issue in an unspecified place.
	struct PassportElementErrorUnspecified {
		// Error source, must be unspecified
		source string
		// Type of element of the user's Telegram Passport which has the issue
		@json("type")
		kind string
		// Base64-encoded element hash
		@json("element_hash")
		elementHash string
		// Error message
		message string
	}

	// This object represents a game.
	struct Game {
		// Title of the game
		title string
		// Description of the game
		description string
		// Photo that will be displayed in the game message in chats
		photo PhotoSize[]
		// Brief description of the game or high scores included in the game message.
		@json(omitempty = true)
		text string
		// Special entities that appear in text, such as usernames, URLs, bot commands, etc.
		@json("text_entities", omitempty = true)
		textEntities MessageEntity[]
		// Animation that will be displayed in the game message in chats.
		@json(omitempty = true)
		animation ?Animation = none
	}

	// A placeholder, currently holds no information.
	struct CallbackGame {
		@json(omitempty = true)
		unused bool
	}

	// This object represents one row of the high scores table for a game.
	struct GameHighScore {
		// Position in high score table for the game
		position int
		// User
		user User
		// Score
		score int
	}
}
