		captionEntities MessageEntity[]
		// Optional.
		@json("reply_markup", omitempty = true)
		replyMarkup ?InlineKeyboardMarkup = none
		// Optional.
		@json("input_message_content", omitempty = true)
		inputMessageContent ?InputMessageContent = none
		// Title for the result
		@json(omitempty = true)
		title string
		// A valid file identifier for the file
		@json("document_file_id", omitempty = true)
		documentFileId string
		// Optional.
		@json(omitempty = true)
		description string
		// A valid file identifier for the GIF file
		@json("gif_file_id", omitempty = true)
		gifFileId string
		// Optional.
		@json("show_caption_above_media", omitempty = true)
		showCaptionAboveMedia bool
		// A valid file identifier of the photo
		@json("photo_file_id", omitempty = true)
		photoFileId string
		// A valid file identifier of the sticker
		@json("sticker_file_id", omitempty = true)
		stickerFileId string
		// A valid file identifier for the video file
		@json("video_file_id", omitempty = true)
		videoFileId string
		// A valid file identifier for the voice message
		@json("voice_file_id", omitempty = true)
		voiceFileId string
		// Optional.
		@json(omitempty = true)
		url string
		// Optional.
		@json("thumbnail_url", omitempty = true)
		thumbnailUrl string
		// Optional.
		@json("thumbnail_width", omitempty = true)
		thumbnailWidth int
		// Optional.
		@json("thumbnail_height", omitempty = true)
		thumbnailHeight int
		// A valid URL for the audio file
		@json("audio_url", omitempty = true)
		audioUrl string
		// Optional.
		@json(omitempty = true)
		performer string
		// Optional.
		@json("audio_duration", omitempty = true)
		audioDuration int
		// Contact's phone number
		@json("phone_number", omitempty = true)
		phoneNumber string
		// Contact's first name
		@json("first_name", omitempty = true)
		firstName string
		// Optional.
		@json("last_name", omitempty = true)
		lastName string
		// Optional.
		@json(omitempty = true)
		vcard string
		// Short name of the game
		@json("game_short_name", omitempty = true)
		gameShortName string
		// A valid URL for the file
		@json("document_url", omitempty = true)
		documentUrl string
		// MIME type of the content of the file, either “application/pdf” or “application/zip”
		@json("mime_type", omitempty = true)
		mimeType string
		// A valid URL for the GIF file
		@json("gif_url", omitempty = true)
		gifUrl string
		// Optional.
		@json("gif_width", omitempty = true)
		gifWidth int
		// Optional.
		@json("gif_height", omitempty = true)
		gifHeight int
		// Optional.
		@json("gif_duration", omitempty = true)
		gifDuration int
		// Optional.
		@json("thumbnail_mime_type", omitempty = true)
		thumbnailMimeType string
		// Location latitude in degrees
		@json(omitempty = true)
		latitude float
		// Location longitude in degrees
		@json(omitempty = true)
		longitude float
		// Optional.
		@json("horizontal_accuracy", omitempty = true)
		horizontalAccuracy float
		// Optional.
		@json("live_period", omitempty = true)
		livePeriod int
		// Optional.
		@json(omitempty = true)
		heading int
		// Optional.
		@json("proximity_alert_radius", omitempty = true)
		proximityAlertRadius int
		// A valid URL of the photo.
		@json("photo_url", omitempty = true)
		photoUrl string
		// Optional.
		@json("photo_width", omitempty = true)
		photoWidth int
		// Optional.
		@json("photo_height", omitempty = true)
		photoHeight int
		// Address of the venue
		@json(omitempty = true)
		address string
		// Optional.
