	// This object represents one special entity in a text message.
	struct MessageEntity {
		// Type of the entity.
		@json("type")
		kind string
		// Offset in UTF-16 code units to the start of the entity
		offset int
		// Length of the entity in UTF-16 code units
		length int
		// For “text_link” only, URL that will be opened after user taps on the text
		@json(omitempty = true)
		url string
		// For “text_mention” only, the mentioned user
		@json(omitempty = true)
		user ?User = none
		// For “pre” only, the programming language of the entity text
		@json(omitempty = true)
		language string
		// For “custom_emoji” only, unique identifier of the custom emoji.
		@json("custom_emoji_id", omitempty = true)
		customEmojiId string
		// For “date_time” only, the Unix time associated with the entity
		@json("unix_time", omitempty = true)
		unixTime int
		// For “date_time” only, the string that defines the formatting of the date and time.
		@json("date_time_format", omitempty = true)
		dateTimeFormat string
	}

	// This object contains information about the quoted part of a message that is replied to by
	// the given message.
	struct TextQuote {
		// Text of the quoted part of a message that is replied to by the given message
		text string
		// Special entities that appear in the quote.
		@json(omitempty = true)
		entities MessageEntity[]
		// Approximate quote position in the original message in UTF-16 code units as specified by
		// the sender
		position int
		// True, if the quote was chosen manually by the message sender.
		@json("is_manual", omitempty = true)
		isManual bool
	}

	// This object contains information about a message that is being replied to, which may come
	// from another chat or forum topic.
	struct ExternalReplyInfo {
		// Origin of the message replied to by the given message
		origin MessageOrigin
		// Chat the original message belongs to.
		@json(omitempty = true)
		chat ?Chat = none
		// Unique message identifier inside the original chat.
		@json("message_id", omitempty = true)
		messageId int
		// Options used for link preview generation for the original message, if it is a text
		// message
		@json("link_preview_options", omitempty = true)
		linkPreviewOptions ?LinkPreviewOptions = none
		// Message is an animation, information about the animation
		@json(omitempty = true)
		animation ?Animation = none
		// Message is an audio file, information about the file
		@json(omitempty = true)
		audio ?Audio = none
		// Message is a general file, information about the file
		@json(omitempty = true)
		document ?Document = none
		// Message is a live photo, information about the live photo
		@json("live_photo", omitempty = true)
		livePhoto ?LivePhoto = none
		// Message contains paid media; information about the paid media
		@json("paid_media", omitempty = true)
		paidMedia ?PaidMediaInfo = none
		// Message is a photo, available sizes of the photo
		@json(omitempty = true)
		photo PhotoSize[]
		// Message is a sticker, information about the sticker
		@json(omitempty = true)
		sticker ?Sticker = none
		// Message is a forwarded story
		@json(omitempty = true)
		story ?Story = none
		// Message is a video, information about the video
		@json(omitempty = true)
		video ?Video = none
		// Message is a video note, information about the video message
		@json("video_note", omitempty = true)
		videoNote ?VideoNote = none
		// Message is a voice message, information about the file
		@json(omitempty = true)
		voice ?Voice = none
		// True, if the message media is covered by a spoiler animation
		@json("has_media_spoiler", omitempty = true)
		hasMediaSpoiler bool
		// Message is a checklist
		@json(omitempty = true)
		checklist ?Checklist = none
		// Message is a shared contact, information about the contact
		@json(omitempty = true)
		contact ?Contact = none
		// Message is a dice with random value
		@json(omitempty = true)
		dice ?Dice = none
		// Message is a game, information about the game.
		@json(omitempty = true)
		game ?Game = none
		// Message is a scheduled giveaway, information about the giveaway
		@json(omitempty = true)
		giveaway ?Giveaway = none
		// A giveaway with public winners was completed
		@json("giveaway_winners", omitempty = true)
		giveawayWinners ?GiveawayWinners = none
		// Message is an invoice for a payment, information about the invoice.
		@json(omitempty = true)
		invoice ?Invoice = none
		// Message is a shared location, information about the location
		@json(omitempty = true)
		location ?Location = none
		// Message is a native poll, information about the poll
		@json(omitempty = true)
		poll ?Poll = none
		// Message is a venue, information about the venue
		@json(omitempty = true)
		venue ?Venue = none
	}

	// Describes reply parameters for the message that is being sent.
	struct ReplyParameters {
		// Identifier of the message that will be replied to in the current chat, or in the chat
		// chat_id if it is specified.
		@json("message_id", omitempty = true)
		messageId int
		// If the message to be replied to is from a different chat, unique identifier for the chat
		// or username of the bot, supergroup or channel in the format @username.
		@json("chat_id", omitempty = true)
		chatId ?any = none
		// Identifier of the incoming ephemeral message that will be replied to in the current
		// chat.
		@json("ephemeral_message_id", omitempty = true)
		ephemeralMessageId int
		// Pass True if the message should be sent even if the specified message to be replied to
		// is not found.
		@json("allow_sending_without_reply", omitempty = true)
		allowSendingWithoutReply bool
		// Quoted part of the message to be replied to; 0-1024 characters after entities parsing.
		@json(omitempty = true)
		quote string
		// Mode for parsing entities in the quote.
		@json("quote_parse_mode", omitempty = true)
		quoteParseMode string
		// A JSON-serialized list of special entities that appear in the quote.
		@json("quote_entities", omitempty = true)
		quoteEntities MessageEntity[]
		// Position of the quote in the original message in UTF-16 code units
		@json("quote_position", omitempty = true)
		quotePosition int
		// Identifier of the specific checklist task to be replied to
		@json("checklist_task_id", omitempty = true)
		checklistTaskId int
		// Persistent identifier of the specific poll option to be replied to
		@json("poll_option_id", omitempty = true)
		pollOptionId string
	}

	// EphemeralMessageParameters
	struct EphemeralMessageParameters {
		// Identifier of the user who will receive the message.
		@json("receiver_user_id")
		receiverUserId int
		// Identifier of the callback query which triggered the message, if any
		@json("callback_query_id", omitempty = true)
		callbackQueryId string
		// Pass True if the ephemeral message must be shown in place of the original message.
		@json("replace_callback_query_message", omitempty = true)
		replaceCallbackQueryMessage bool
	}

	// This object describes the origin of a message.
	// One struct holds the fields of every kind: MessageOriginUser, MessageOriginHiddenUser, MessageOriginChat, MessageOriginChannel.
	struct MessageOrigin {
		// Type of the message origin, always “user”
		@json("type", omitempty = true)
		kind string
		// Date the message was sent originally in Unix time
		@json(omitempty = true)
		date int
		// User that sent the message originally
		@json("sender_user", omitempty = true)
		senderUser ?User = none
		// Name of the user that sent the message originally
		@json("sender_user_name", omitempty = true)
		senderUserName string
		// Chat that sent the message originally
		@json("sender_chat", omitempty = true)
		senderChat ?Chat = none
		// Optional.
		@json("author_signature", omitempty = true)
		authorSignature string
		// Channel chat to which the message was originally sent
		@json(omitempty = true)
		chat ?Chat = none
		// Unique message identifier inside the chat
		@json("message_id", omitempty = true)
		messageId int
	}

	// The message was originally sent by a known user.
	struct MessageOriginUser {
		// Type of the message origin, always “user”
		@json("type")
		kind string
		// Date the message was sent originally in Unix time
		date int
		// User that sent the message originally
		@json("sender_user")
		senderUser User
	}

	// The message was originally sent by an unknown user.
	struct MessageOriginHiddenUser {
		// Type of the message origin, always “hidden_user”
		@json("type")
		kind string
		// Date the message was sent originally in Unix time
		date int
		// Name of the user that sent the message originally
		@json("sender_user_name")
		senderUserName string
	}

	// The message was originally sent on behalf of a chat to a group chat.
	struct MessageOriginChat {
		// Type of the message origin, always “chat”
		@json("type")
		kind string
		// Date the message was sent originally in Unix time
		date int
		// Chat that sent the message originally
		@json("sender_chat")
		senderChat Chat
		// For messages originally sent by an anonymous chat administrator, original message author
		// signature
		@json("author_signature", omitempty = true)
		authorSignature string
	}

	// The message was originally sent to a channel chat.
	struct MessageOriginChannel {
		// Type of the message origin, always “channel”
		@json("type")
		kind string
		// Date the message was sent originally in Unix time
		date int
		// Channel chat to which the message was originally sent
		chat Chat
		// Unique message identifier inside the chat
		@json("message_id")
		messageId int
		// Signature of the original post author
		@json("author_signature", omitempty = true)
		authorSignature string
	}

	// This object represents one size of a photo or a file / sticker thumbnail.
	struct PhotoSize {
		// Identifier for this file, which can be used to download or reuse the file
		@json("file_id")
		fileId string
		// Unique identifier for this file, which is supposed to be the same over time and for
		// different bots.
		@json("file_unique_id")
		fileUniqueId string
		// Photo width
		width int
		// Photo height
		height int
		// File size in bytes
		@json("file_size", omitempty = true)
		fileSize int
	}

	// This object represents an animation file (GIF or H.264/MPEG-4 AVC video without sound).
	struct Animation {
		// Identifier for this file, which can be used to download or reuse the file
		@json("file_id")
		fileId string
		// Unique identifier for this file, which is supposed to be the same over time and for
		// different bots.
		@json("file_unique_id")
		fileUniqueId string
		// Video width as defined by the sender
		width int
		// Video height as defined by the sender
		height int
		// Duration of the video in seconds as defined by the sender
		duration int
		// Animation thumbnail as defined by the sender
		@json(omitempty = true)
		thumbnail ?PhotoSize = none
		// Original animation filename as defined by the sender
		@json("file_name", omitempty = true)
		fileName string
		// MIME type of the file as defined by the sender
		@json("mime_type", omitempty = true)
		mimeType string
		// File size in bytes.
		@json("file_size", omitempty = true)
		fileSize int
	}

	// This object represents an audio file to be treated as music by the Telegram clients.
	struct Audio {
		// Identifier for this file, which can be used to download or reuse the file
		@json("file_id")
		fileId string
		// Unique identifier for this file, which is supposed to be the same over time and for
		// different bots.
		@json("file_unique_id")
		fileUniqueId string
		// Duration of the audio in seconds as defined by the sender
		duration int
		// Performer of the audio as defined by the sender or by audio tags
		@json(omitempty = true)
		performer string
		// Title of the audio as defined by the sender or by audio tags
		@json(omitempty = true)
		title string
		// Original filename as defined by the sender
		@json("file_name", omitempty = true)
		fileName string
		// MIME type of the file as defined by the sender
		@json("mime_type", omitempty = true)
		mimeType string
		// File size in bytes.
		@json("file_size", omitempty = true)
		fileSize int
		// Thumbnail of the album cover to which the music file belongs
		@json(omitempty = true)
		thumbnail ?PhotoSize = none
	}

	// This object represents a general file (as opposed to photos, voice messages and audio
	// files).
	struct Document {
		// Identifier for this file, which can be used to download or reuse the file
		@json("file_id")
		fileId string
		// Unique identifier for this file, which is supposed to be the same over time and for
		// different bots.
		@json("file_unique_id")
		fileUniqueId string
		// Document thumbnail as defined by the sender
		@json(omitempty = true)
		thumbnail ?PhotoSize = none
		// Original filename as defined by the sender
		@json("file_name", omitempty = true)
		fileName string
		// MIME type of the file as defined by the sender
		@json("mime_type", omitempty = true)
		mimeType string
		// File size in bytes.
		@json("file_size", omitempty = true)
		fileSize int
	}

	// This object represents a live photo.
	struct LivePhoto {
		// Available sizes of the corresponding static photo
		@json(omitempty = true)
		photo PhotoSize[]
		// Identifier for the video file which can be used to download or reuse the file
		@json("file_id")
		fileId string
		// Unique identifier for the video file which is supposed to be the same over time and for
		// different bots.
		@json("file_unique_id")
		fileUniqueId string
		// Video width as defined by the sender
		width int
		// Video height as defined by the sender
		height int
		// Duration of the video in seconds as defined by the sender
		duration int
		// MIME type of the file as defined by the sender
		@json("mime_type", omitempty = true)
		mimeType string
		// File size in bytes.
		@json("file_size", omitempty = true)
		fileSize int
	}

	// This object represents a story.
	struct Story {
		// Chat that posted the story
		chat Chat
		// Unique identifier for the story in the chat
		id int
	}

	// This object represents a video file of a specific quality.
	struct VideoQuality {
		// Identifier for this file, which can be used to download or reuse the file
		@json("file_id")
		fileId string
		// Unique identifier for this file, which is supposed to be the same over time and for
		// different bots.
		@json("file_unique_id")
		fileUniqueId string
		// Video width
		width int
		// Video height
		height int
		// Codec that was used to encode the video, for example, “h264”, “h265”, or “av01”
		codec string
		// File size in bytes.
		@json("file_size", omitempty = true)
		fileSize int
	}

	// This object represents a video file.
	struct Video {
		// Identifier for this file, which can be used to download or reuse the file
		@json("file_id")
		fileId string
		// Unique identifier for this file, which is supposed to be the same over time and for
		// different bots.
		@json("file_unique_id")
		fileUniqueId string
		// Video width as defined by the sender
		width int
		// Video height as defined by the sender
		height int
		// Duration of the video in seconds as defined by the sender
		duration int
		// Video thumbnail
		@json(omitempty = true)
		thumbnail ?PhotoSize = none
		// Available sizes of the cover of the video in the message
		@json(omitempty = true)
		cover PhotoSize[]
		// Timestamp in seconds from which the video will play in the message
		@json("start_timestamp", omitempty = true)
		startTimestamp int
		// List of available qualities of the video
		@json(omitempty = true)
		qualities VideoQuality[]
		// Original filename as defined by the sender
		@json("file_name", omitempty = true)
		fileName string
		// MIME type of the file as defined by the sender
		@json("mime_type", omitempty = true)
		mimeType string
		// File size in bytes.
		@json("file_size", omitempty = true)
		fileSize int
	}

	// This object represents a video message.
	struct VideoNote {
		// Identifier for this file, which can be used to download or reuse the file
		@json("file_id")
		fileId string
		// Unique identifier for this file, which is supposed to be the same over time and for
		// different bots.
		@json("file_unique_id")
		fileUniqueId string
		// Video width and height (diameter of the video message) as defined by the sender
		length int
		// Duration of the video in seconds as defined by the sender
		duration int
		// Video thumbnail
		@json(omitempty = true)
		thumbnail ?PhotoSize = none
		// File size in bytes
		@json("file_size", omitempty = true)
		fileSize int
	}

	// This object represents a voice note.
	struct Voice {
		// Identifier for this file, which can be used to download or reuse the file
		@json("file_id")
		fileId string
		// Unique identifier for this file, which is supposed to be the same over time and for
		// different bots.
		@json("file_unique_id")
		fileUniqueId string
		// Duration of the audio in seconds as defined by the sender
		duration int
		// MIME type of the file as defined by the sender
		@json("mime_type", omitempty = true)
		mimeType string
		// File size in bytes.
		@json("file_size", omitempty = true)
		fileSize int
	}

	// Describes the paid media added to a message.
	struct PaidMediaInfo {
		// The number of Telegram Stars that must be paid to buy access to the media
		@json("star_count")
		starCount int
		// Information about the paid media
		@json("paid_media")
		paidMedia PaidMedia[]
	}

	// This object describes paid media.
	// One struct holds the fields of every kind: PaidMediaLivePhoto, PaidMediaPhoto, PaidMediaPreview, PaidMediaVideo.
	struct PaidMedia {
		// Type of the paid media, always “live_photo”
		@json("type", omitempty = true)
		kind string
		// The photo
		@json("live_photo", omitempty = true)
		livePhoto ?LivePhoto = none
		// The photo
		@json(omitempty = true)
		photo PhotoSize[]
		// Optional.
		@json(omitempty = true)
		width int
		// Optional.
		@json(omitempty = true)
		height int
		// Optional.
		@json(omitempty = true)
		duration int
		// The video
		@json(omitempty = true)
		video ?Video = none
	}

	// The paid media is a live photo.
	struct PaidMediaLivePhoto {
		// Type of the paid media, always “live_photo”
		@json("type")
		kind string
		// The photo
		@json("live_photo")
		livePhoto LivePhoto
	}

	// The paid media is a photo.
	struct PaidMediaPhoto {
		// Type of the paid media, always “photo”
		@json("type")
		kind string
		// The photo
		photo PhotoSize[]
	}

	// The paid media isn't available before the payment.
	struct PaidMediaPreview {
		// Type of the paid media, always “preview”
		@json("type")
		kind string
		// Media width as defined by the sender
		@json(omitempty = true)
		width int
		// Media height as defined by the sender
		@json(omitempty = true)
		height int
		// Duration of the media in seconds as defined by the sender
		@json(omitempty = true)
		duration int
	}

	// The paid media is a video.
	struct PaidMediaVideo {
		// Type of the paid media, always “video”
		@json("type")
		kind string
		// The video
		video Video
	}

	// This object represents a phone contact.
	struct Contact {
		// Contact's phone number
		@json("phone_number")
		phoneNumber string
		// Contact's first name
		@json("first_name")
		firstName string
		// Contact's last name
		@json("last_name", omitempty = true)
		lastName string
		// Contact's user identifier in Telegram.
		@json("user_id", omitempty = true)
		userId int
		// Additional data about the contact in the form of a vCard
		@json(omitempty = true)
		vcard string
	}

	// This object represents an animated emoji that displays a random value.
	struct Dice {
		// Emoji on which the dice throw animation is based
		emoji string
		// Value of the dice, 1-6 for “”, “” and “” base emoji, 1-5 for “” and “” base emoji, 1-64
		// for “” base emoji
		value int
	}

	// Represents an HTTP link.
	struct Link {
		// URL of the link
		url string
	}

	// At most one of the optional fields can be present in any given object.
	struct PollMedia {
		// Media is an animation, information about the animation
		@json(omitempty = true)
		animation ?Animation = none
		// Media is an audio file, information about the file; currently, can't be received in a
		// poll option
		@json(omitempty = true)
		audio ?Audio = none
		// Media is a general file, information about the file; currently, can't be received in a
		// poll option
		@json(omitempty = true)
		document ?Document = none
		// The HTTP link attached to the poll option
		@json(omitempty = true)
		link ?Link = none
		// Media is a live photo, information about the live photo
		@json("live_photo", omitempty = true)
		livePhoto ?LivePhoto = none
		// Media is a shared location, information about the location
		@json(omitempty = true)
		location ?Location = none
		// Media is a photo, available sizes of the photo
		@json(omitempty = true)
		photo PhotoSize[]
		// Media is a sticker, information about the sticker; currently, for poll options only
		@json(omitempty = true)
		sticker ?Sticker = none
		// Media is a venue, information about the venue
		@json(omitempty = true)
		venue ?Venue = none
		// Media is a video, information about the video
		@json(omitempty = true)
		video ?Video = none
	}

	// This object represents the content of a poll description or a quiz explanation to be
	// sent.
	// One struct holds the fields of every kind: InputMediaAnimation, InputMediaAudio, InputMediaDocument, InputMediaLivePhoto, InputMediaLocation, InputMediaPhoto, InputMediaVenue, InputMediaVideo.
	struct InputPollMedia {
		// Type of the media, must be animation
		@json("type", omitempty = true)
		kind string
		// File to send.
		@json(omitempty = true)
		media ?any = none
		// Optional.
		@json(omitempty = true)
		thumbnail ?any = none
		// Optional.
		@json(omitempty = true)
		caption string
		// Optional.
		@json("parse_mode", omitempty = true)
		parseMode string
		// Optional.
		@json("caption_entities", omitempty = true)
		captionEntities MessageEntity[]
		// Optional.
		@json("show_caption_above_media", omitempty = true)
		showCaptionAboveMedia bool
		// Optional.
		@json(omitempty = true)
		width int
		// Optional.
		@json(omitempty = true)
		height int
		// Optional.
		@json(omitempty = true)
		duration int
		// Optional.
		@json("has_spoiler", omitempty = true)
		hasSpoiler bool
		// Optional.
		@json(omitempty = true)
		performer string
		// Optional.
		@json(omitempty = true)
		title string
		// Optional.
		@json("disable_content_type_detection", omitempty = true)
		disableContentTypeDetection bool
		// The static photo to send.
		@json(omitempty = true)
		photo ?any = none
		// Latitude of the location
		@json(omitempty = true)
		latitude float
		// Longitude of the location
		@json(omitempty = true)
		longitude float
		// Optional.
		@json("horizontal_accuracy", omitempty = true)
		horizontalAccuracy float
		// Address of the venue
		@json(omitempty = true)
		address string
		// Optional.
		@json("foursquare_id", omitempty = true)
		foursquareId string
		// Optional.
		@json("foursquare_type", omitempty = true)
		foursquareType string
		// Optional.
		@json("google_place_id", omitempty = true)
		googlePlaceId string
		// Optional.
		@json("google_place_type", omitempty = true)
		googlePlaceType string
		// Optional.
		@json(omitempty = true)
		cover ?any = none
		// Optional.
		@json("start_timestamp", omitempty = true)
		startTimestamp int
		// Optional.
		@json("supports_streaming", omitempty = true)
		supportsStreaming bool
	}

	// This object represents the content of a poll option to be sent.
	// One struct holds the fields of every kind: InputMediaAnimation, InputMediaLink, InputMediaLivePhoto, InputMediaLocation, InputMediaPhoto, InputMediaSticker, InputMediaVenue, InputMediaVideo.
	struct InputPollOptionMedia {
		// Type of the media, must be animation
		@json("type", omitempty = true)
		kind string
		// File to send.
		@json(omitempty = true)
		media ?any = none
		// Optional.
		@json(omitempty = true)
		thumbnail ?any = none
		// Optional.
		@json(omitempty = true)
		caption string
		// Optional.
		@json("parse_mode", omitempty = true)
		parseMode string
		// Optional.
		@json("caption_entities", omitempty = true)
		captionEntities MessageEntity[]
		// Optional.
		@json("show_caption_above_media", omitempty = true)
		showCaptionAboveMedia bool
		// Optional.
		@json(omitempty = true)
		width int
		// Optional.
		@json(omitempty = true)
		height int
		// Optional.
		@json(omitempty = true)
		duration int
		// Optional.
		@json("has_spoiler", omitempty = true)
		hasSpoiler bool
		// HTTP URL of the link
		@json(omitempty = true)
		url string
		// The static photo to send.
		@json(omitempty = true)
		photo ?any = none
		// Latitude of the location
		@json(omitempty = true)
		latitude float
		// Longitude of the location
		@json(omitempty = true)
		longitude float
		// Optional.
		@json("horizontal_accuracy", omitempty = true)
		horizontalAccuracy float
		// Optional.
		@json(omitempty = true)
		emoji string
		// Name of the venue
		@json(omitempty = true)
		title string
		// Address of the venue
		@json(omitempty = true)
		address string
		// Optional.
		@json("foursquare_id", omitempty = true)
		foursquareId string
		// Optional.
		@json("foursquare_type", omitempty = true)
		foursquareType string
		// Optional.
		@json("google_place_id", omitempty = true)
		googlePlaceId string
		// Optional.
		@json("google_place_type", omitempty = true)
		googlePlaceType string
		// Optional.
		@json(omitempty = true)
		cover ?any = none
		// Optional.
		@json("start_timestamp", omitempty = true)
		startTimestamp int
		// Optional.
		@json("supports_streaming", omitempty = true)
		supportsStreaming bool
	}

	// This object contains information about one answer option in a poll.
	struct PollOption {
		// Unique identifier of the option, persistent on option addition and deletion
		@json("persistent_id")
		persistentId string
		// Option text, 1-100 characters
		text string
		// Special entities that appear in the option text.
		@json("text_entities", omitempty = true)
		textEntities MessageEntity[]
		// Media added to the poll option
		@json(omitempty = true)
		media ?PollMedia = none
		// Number of users who voted for this option; may be 0 if unknown
		@json("voter_count")
		voterCount int
		// User who added the option; omitted if the option wasn't added by a user after poll
		// creation
		@json("added_by_user", omitempty = true)
		addedByUser ?User = none
		// Chat that added the option; omitted if the option wasn't added by a chat after poll
		// creation
		@json("added_by_chat", omitempty = true)
		addedByChat ?Chat = none
		// Point in time (Unix timestamp) when the option was added; omitted if the option existed
		// in the original poll
		@json("addition_date", omitempty = true)
		additionDate int
	}

	// This object contains information about one answer option in a poll to be sent.
	struct InputPollOption {
		// Option text, 1-100 characters
		text string
		// Mode for parsing entities in the text.
		@json("text_parse_mode", omitempty = true)
		textParseMode string
		// A JSON-serialized list of special entities that appear in the poll option text.
		@json("text_entities", omitempty = true)
		textEntities MessageEntity[]
		// Media added to the poll option
		@json(omitempty = true)
		media ?InputPollOptionMedia = none
	}

	// This object represents an answer of a user in a non-anonymous poll.
	struct PollAnswer {
		// Unique poll identifier
		@json("poll_id")
		pollId string
		// The chat that changed the answer to the poll, if the voter is anonymous
		@json("voter_chat", omitempty = true)
		voterChat ?Chat = none
		// The user that changed the answer to the poll, if the voter isn't anonymous
		@json(omitempty = true)
		user ?User = none
		// 0-based identifiers of chosen answer options.
		@json("option_ids")
		optionIds int[]
		// Persistent identifiers of the chosen answer options.
		@json("option_persistent_ids")
		optionPersistentIds string[]
	}

	// This object contains information about a poll.
	struct Poll {
		// Unique poll identifier
		id string
		// Poll question, 1-300 characters
		question string
		// Special entities that appear in the question.
		@json("question_entities", omitempty = true)
		questionEntities MessageEntity[]
		// List of poll options
		options PollOption[]
		// Total number of users that voted in the poll
		@json("total_voter_count")
		totalVoterCount int
		// True, if the poll is closed
		@json("is_closed")
		isClosed bool
		// True, if the poll is anonymous
		@json("is_anonymous")
		isAnonymous bool
		// Poll type, currently can be “regular” or “quiz”
		@json("type")
		kind string
		// True, if the poll allows multiple answers
		@json("allows_multiple_answers")
		allowsMultipleAnswers bool
		// True, if the poll allows to change the chosen answer options
		@json("allows_revoting")
		allowsRevoting bool
		// True if voting is limited to users who have been members of the chat where the poll was
		// originally sent for more than 24 hours
		@json("members_only")
		membersOnly bool
		// A list of two-letter ISO 3166-1 alpha-2 country codes indicating the countries from
		// which users can vote in the poll.
		@json("country_codes", omitempty = true)
		countryCodes string[]
		// Array of 0-based identifiers of the correct answer options.
		@json("correct_option_ids", omitempty = true)
		correctOptionIds int[]
		// Text that is shown when a user chooses an incorrect answer or taps on the lamp icon in a
		// quiz-style poll, 0-200 characters
		@json(omitempty = true)
		explanation string
		// Special entities like usernames, URLs, bot commands, etc.
		@json("explanation_entities", omitempty = true)
		explanationEntities MessageEntity[]
		// Media added to the quiz explanation
		@json("explanation_media", omitempty = true)
		explanationMedia ?PollMedia = none
		// Amount of time in seconds the poll will be active after creation
		@json("open_period", omitempty = true)
		openPeriod int
		// Point in time (Unix timestamp) when the poll will be automatically closed
		@json("close_date", omitempty = true)
		closeDate int
		// Description of the poll; for polls inside the Message object only
		@json(omitempty = true)
		description string
		// Special entities like usernames, URLs, bot commands, etc.
		@json("description_entities", omitempty = true)
		descriptionEntities MessageEntity[]
		// Media added to the poll description; for polls inside the Message object only
		@json(omitempty = true)
		media ?PollMedia = none
	}

	// Describes a task in a checklist.
	struct ChecklistTask {
		// Unique identifier of the task
		id int
		// Text of the task
		text string
		// Special entities that appear in the task text
		@json("text_entities", omitempty = true)
		textEntities MessageEntity[]
		// User that completed the task; omitted if the task wasn't completed by a user
		@json("completed_by_user", omitempty = true)
		completedByUser ?User = none
		// Chat that completed the task; omitted if the task wasn't completed by a chat
		@json("completed_by_chat", omitempty = true)
		completedByChat ?Chat = none
		// Point in time (Unix timestamp) when the task was completed; 0 if the task wasn't
		// completed
		@json("completion_date", omitempty = true)
		completionDate int
	}

	// Describes a checklist.
	struct Checklist {
		// Title of the checklist
		title string
		// Special entities that appear in the checklist title
		@json("title_entities", omitempty = true)
		titleEntities MessageEntity[]
		// List of tasks in the checklist
		tasks ChecklistTask[]
		// True, if users other than the creator of the list can add tasks to the list
		@json("others_can_add_tasks", omitempty = true)
		othersCanAddTasks bool
		// True, if users other than the creator of the list can mark tasks as done or not done
		@json("others_can_mark_tasks_as_done", omitempty = true)
		othersCanMarkTasksAsDone bool
	}

	// Describes a task to add to a checklist.
	struct InputChecklistTask {
		// Unique identifier of the task; must be positive and unique among all task identifiers
		// currently present in the checklist
		id int
		// Text of the task; 1-100 characters after entities parsing
		text string
		// Mode for parsing entities in the text.
		@json("parse_mode", omitempty = true)
		parseMode string
		// List of special entities that appear in the text, which can be specified instead of
		// parse_mode.
		@json("text_entities", omitempty = true)
		textEntities MessageEntity[]
	}

	// Describes a checklist to create.
	struct InputChecklist {
		// Title of the checklist; 1-255 characters after entities parsing
		title string
		// Mode for parsing entities in the title.
		@json("parse_mode", omitempty = true)
		parseMode string
		// List of special entities that appear in the title, which can be specified instead of
		// parse_mode.
		@json("title_entities", omitempty = true)
		titleEntities MessageEntity[]
		// List of 1-30 tasks in the checklist
		tasks InputChecklistTask[]
		// Pass True if other users can add tasks to the checklist
		@json("others_can_add_tasks", omitempty = true)
		othersCanAddTasks bool
		// Pass True if other users can mark tasks as done or not done in the checklist
		@json("others_can_mark_tasks_as_done", omitempty = true)
		othersCanMarkTasksAsDone bool
	}

	// This object represents a point on the map.
	struct Location {
		// Latitude as defined by the sender
		latitude float
		// Longitude as defined by the sender
		longitude float
		// The radius of uncertainty for the location, measured in meters; 0-1500
		@json("horizontal_accuracy", omitempty = true)
		horizontalAccuracy float
		// Time relative to the message sending date, during which the location can be updated; in
		// seconds.
		@json("live_period", omitempty = true)
		livePeriod int
		// The direction in which user is moving, in degrees; 1-360.
		@json(omitempty = true)
		heading int
		// The maximum distance for proximity alerts about approaching another chat member, in
		// meters.
		@json("proximity_alert_radius", omitempty = true)
		proximityAlertRadius int
	}

	// This object represents a venue.
	struct Venue {
		// Venue location.
		location Location
		// Name of the venue
		title string
		// Address of the venue
		address string
		// Foursquare identifier of the venue
		@json("foursquare_id", omitempty = true)
		foursquareId string
		// Foursquare type of the venue.
		@json("foursquare_type", omitempty = true)
		foursquareType string
		// Google Places identifier of the venue
		@json("google_place_id", omitempty = true)
		googlePlaceId string
		// Google Places type of the venue.
		@json("google_place_type", omitempty = true)
		googlePlaceType string
	}

	// Describes data sent from a Web App to the bot.
	struct WebAppData {
		// The data.
		data string
		// Text of the web_app keyboard button from which the Web App was opened.
		@json("button_text")
		buttonText string
	}

	// This object represents the content of a service message, sent whenever a user in the chat
	// triggers a proximity alert set by another user.
	struct ProximityAlertTriggered {
		// User that triggered the alert
		traveler User
		// User that set the alert
		watcher User
		// The distance between the users
		distance int
	}

	// This object represents a service message about a change in auto-delete timer settings.
	struct MessageAutoDeleteTimerChanged {
		// New auto-delete time for messages in the chat; in seconds
		@json("message_auto_delete_time")
		messageAutoDeleteTime int
	}

	// This object contains information about the bot that was created to be managed by the
	// current bot.
	struct ManagedBotCreated {
		// Information about the bot.
		bot User
	}

	// This object contains information about the creation, token update, or owner update of a
	// bot that is managed by the current bot.
	struct ManagedBotUpdated {
		// User that created the bot
		user User
		// Information about the bot.
		bot User
	}

	// This object contains information about changes to a user payment subscription toward the
	// current bot.
	struct BotSubscriptionUpdated {
		// User who subscribed for payments toward the bot
		user User
		// Bot-specified invoice payload
		@json("invoice_payload")
		invoicePayload string
		// The new state of the subscription.
		state string
	}

	// This object describes an update about a user stopping message generation.
	struct MessageGenerationStopped {
		// Chat in which the message is generated
		chat Chat
		// Unique identifier of the message thread in which the message is generated
		@json("message_thread_id", omitempty = true)
		messageThreadId int
		// Unique identifier of the message draft which was stopped
		@json("draft_id")
		draftId int
	}

	// Describes a service message about an option added to a poll.
	struct PollOptionAdded {
		// Message containing the poll to which the option was added, if known.
		@json("poll_message", omitempty = true)
		pollMessage ?MaybeInaccessibleMessage = none
		// Unique identifier of the added option
		@json("option_persistent_id")
		optionPersistentId string
		// Option text
		@json("option_text")
		optionText string
		// Special entities that appear in the option_text
		@json("option_text_entities", omitempty = true)
		optionTextEntities MessageEntity[]
	}

	// Describes a service message about an option deleted from a poll.
	struct PollOptionDeleted {
		// Message containing the poll from which the option was deleted, if known.
		@json("poll_message", omitempty = true)
		pollMessage ?MaybeInaccessibleMessage = none
		// Unique identifier of the deleted option
		@json("option_persistent_id")
		optionPersistentId string
		// Option text
		@json("option_text")
		optionText string
		// Special entities that appear in the option_text
		@json("option_text_entities", omitempty = true)
		optionTextEntities MessageEntity[]
	}

	// This object represents a service message about a user boosting a chat.
	struct ChatBoostAdded {
		// Number of boosts added by the user
		@json("boost_count")
		boostCount int
	}

	// This object describes the way a background is filled based on the selected colors.
	// One struct holds the fields of every kind: BackgroundFillSolid, BackgroundFillGradient, BackgroundFillFreeformGradient.
	struct BackgroundFill {
		// Type of the background fill, always “solid”
		@json("type", omitempty = true)
		kind string
		// The color of the background fill in the RGB24 format
		@json(omitempty = true)
		color int
		// Top color of the gradient in the RGB24 format
		@json("top_color", omitempty = true)
		topColor int
		// Bottom color of the gradient in the RGB24 format
		@json("bottom_color", omitempty = true)
		bottomColor int
		// Clockwise rotation angle of the background fill in degrees; 0-359
		@json("rotation_angle", omitempty = true)
		rotationAngle int
		// A list of the 3 or 4 base colors that are used to generate the freeform gradient in the
		// RGB24 format
		@json(omitempty = true)
		colors int[]
	}

	// The background is filled using the selected color.
	struct BackgroundFillSolid {
		// Type of the background fill, always “solid”
		@json("type")
		kind string
		// The color of the background fill in the RGB24 format
		color int
	}

	// The background is a gradient fill.
	struct BackgroundFillGradient {
		// Type of the background fill, always “gradient”
		@json("type")
		kind string
		// Top color of the gradient in the RGB24 format
		@json("top_color")
		topColor int
		// Bottom color of the gradient in the RGB24 format
		@json("bottom_color")
		bottomColor int
		// Clockwise rotation angle of the background fill in degrees; 0-359
		@json("rotation_angle")
		rotationAngle int
	}

	// The background is a freeform gradient that rotates after every message in the chat.
	struct BackgroundFillFreeformGradient {
		// Type of the background fill, always “freeform_gradient”
		@json("type")
		kind string
		// A list of the 3 or 4 base colors that are used to generate the freeform gradient in the
		// RGB24 format
		colors int[]
	}

	// This object describes the type of a background.
	// One struct holds the fields of every kind: BackgroundTypeFill, BackgroundTypeWallpaper, BackgroundTypePattern, BackgroundTypeChatTheme.
	struct BackgroundType {
		// Type of the background, always “fill”
		@json("type", omitempty = true)
		kind string
		// The background fill
		@json(omitempty = true)
		fill ?BackgroundFill = none
		// Dimming of the background in dark themes, as a percentage; 0-100
		@json("dark_theme_dimming", omitempty = true)
		darkThemeDimming int
		// Document with the wallpaper
		@json(omitempty = true)
		document ?Document = none
		// Optional.
		@json("is_blurred", omitempty = true)
		isBlurred bool
		// Optional.
		@json("is_moving", omitempty = true)
		isMoving bool
		// Intensity of the pattern when it is shown above the filled background; 0-100
		@json(omitempty = true)
		intensity int
		// Optional.
		@json("is_inverted", omitempty = true)
		isInverted bool
		// Name of the chat theme, which is usually an emoji
		@json("theme_name", omitempty = true)
		themeName string
	}

	// The background is automatically filled based on the selected colors.
	struct BackgroundTypeFill {
		// Type of the background, always “fill”
		@json("type")
		kind string
		// The background fill
		fill BackgroundFill
		// Dimming of the background in dark themes, as a percentage; 0-100
		@json("dark_theme_dimming")
		darkThemeDimming int
	}

	// The background is a wallpaper in the JPEG format.
	struct BackgroundTypeWallpaper {
		// Type of the background, always “wallpaper”
		@json("type")
		kind string
		// Document with the wallpaper
		document Document
		// Dimming of the background in dark themes, as a percentage; 0-100
		@json("dark_theme_dimming")
		darkThemeDimming int
		// True, if the wallpaper is downscaled to fit in a 450x450 square and then box-blurred
		// with radius 12
		@json("is_blurred", omitempty = true)
		isBlurred bool
		// True, if the background moves slightly when the device is tilted
		@json("is_moving", omitempty = true)
		isMoving bool
	}

	// The background is a .PNG or .TGV (gzipped subset of SVG with MIME type
	// “application/x-tgwallpattern”) pattern to be combined with the background fill chosen by
	// the user.
	struct BackgroundTypePattern {
		// Type of the background, always “pattern”
		@json("type")
		kind string
		// Document with the pattern
		document Document
		// The background fill that is combined with the pattern
		fill BackgroundFill
		// Intensity of the pattern when it is shown above the filled background; 0-100
		intensity int
		// True, if the background fill must be applied only to the pattern itself.
		@json("is_inverted", omitempty = true)
		isInverted bool
		// True, if the background moves slightly when the device is tilted
		@json("is_moving", omitempty = true)
		isMoving bool
	}

	// The background is taken directly from a built-in chat theme.
	struct BackgroundTypeChatTheme {
		// Type of the background, always “chat_theme”
		@json("type")
		kind string
		// Name of the chat theme, which is usually an emoji
		@json("theme_name")
		themeName string
	}

	// This object represents a chat background.
	struct ChatBackground {
		// Type of the background
		@json("type")
		kind BackgroundType
	}

	// Describes a service message about checklist tasks marked as done or not done.
	struct ChecklistTasksDone {
		// Message containing the checklist whose tasks were marked as done or not done.
		@json("checklist_message", omitempty = true)
		checklistMessage ?Message = none
		// Identifiers of the tasks that were marked as done
		@json("marked_as_done_task_ids", omitempty = true)
		markedAsDoneTaskIds int[]
		// Identifiers of the tasks that were marked as not done
		@json("marked_as_not_done_task_ids", omitempty = true)
		markedAsNotDoneTaskIds int[]
	}

	// Describes a service message about tasks added to a checklist.
	struct ChecklistTasksAdded {
		// Message containing the checklist to which the tasks were added.
		@json("checklist_message", omitempty = true)
		checklistMessage ?Message = none
		// List of tasks added to the checklist
		tasks ChecklistTask[]
	}

	// Describes a service message about a chat or a bot being added to a community.
	struct CommunityChatAdded {
		// The new community to which the chat or the bot belongs
		community Community
	}

	// Describes a service message about a chat being joined by a user from a community.
	struct CommunityChatJoined {
		// The community from which the chat was joined
		community Community
	}

	// Describes a service message about a chat or a bot being removed from a community.
	struct CommunityChatRemoved {
		@json(omitempty = true)
		unused bool
	}

	// This object represents a service message about a new forum topic created in the chat.
	struct ForumTopicCreated {
		// Name of the topic
		name string
		// Color of the topic icon in RGB format
		@json("icon_color")
		iconColor int
		// Unique identifier of the custom emoji shown as the topic icon
		@json("icon_custom_emoji_id", omitempty = true)
		iconCustomEmojiId string
		// True, if the name of the topic wasn't specified explicitly by its creator and likely
		// needs to be changed by the bot
		@json("is_name_implicit", omitempty = true)
		isNameImplicit bool
	}

	// This object represents a service message about a forum topic closed in the chat.
	struct ForumTopicClosed {
		@json(omitempty = true)
		unused bool
	}

	// This object represents a service message about an edited forum topic.
	struct ForumTopicEdited {
		// New name of the topic, if it was edited
		@json(omitempty = true)
		name string
		// New identifier of the custom emoji shown as the topic icon, if it was edited; an empty
		// string if the icon was removed
		@json("icon_custom_emoji_id", omitempty = true)
		iconCustomEmojiId string
	}

	// This object represents a service message about a forum topic reopened in the chat.
	struct ForumTopicReopened {
		@json(omitempty = true)
		unused bool
	}

	// This object represents a service message about General forum topic hidden in the chat.
	struct GeneralForumTopicHidden {
		@json(omitempty = true)
		unused bool
	}

	// This object represents a service message about General forum topic unhidden in the chat.
	struct GeneralForumTopicUnhidden {
		@json(omitempty = true)
		unused bool
	}

	// This object contains information about a user that was shared with the bot using a
	// KeyboardButtonRequestUsers button.
	struct SharedUser {
		// Identifier of the shared user.
		@json("user_id")
		userId int
		// First name of the user, if the name was requested by the bot
		@json("first_name", omitempty = true)
		firstName string
		// Last name of the user, if the name was requested by the bot
		@json("last_name", omitempty = true)
		lastName string
		// Username of the user, if the username was requested by the bot
		@json(omitempty = true)
		username string
		// Available sizes of the chat photo, if the photo was requested by the bot
		@json(omitempty = true)
		photo PhotoSize[]
	}

	// This object contains information about the users whose identifiers were shared with the
	// bot using a KeyboardButtonRequestUsers button.
	struct UsersShared {
		// Identifier of the request
		@json("request_id")
		requestId int
		// Information about users shared with the bot
		users SharedUser[]
	}

	// This object contains information about a chat that was shared with the bot using a
	// KeyboardButtonRequestChat button.
	struct ChatShared {
		// Identifier of the request
		@json("request_id")
		requestId int
		// Identifier of the shared chat.
		@json("chat_id")
		chatId int
		// Title of the chat, if the title was requested by the bot
		@json(omitempty = true)
		title string
		// Username of the chat, if the username was requested by the bot and available
		@json(omitempty = true)
		username string
		// Available sizes of the chat photo, if the photo was requested by the bot
		@json(omitempty = true)
		photo PhotoSize[]
	}

	// This object represents a service message about a user allowing a bot to write messages
	// after adding it to the attachment menu, launching a Web App from a link, or accepting an
	// explicit request from a Web App sent by the method requestWriteAccess.
	struct WriteAccessAllowed {
		// True, if the access was granted after the user accepted an explicit request from a Web
		// App sent by the method requestWriteAccess
		@json("from_request", omitempty = true)
		fromRequest bool
		// Name of the Web App, if the access was granted when the Web App was launched from a link
		@json("web_app_name", omitempty = true)
		webAppName string
		// True, if the access was granted when the bot was added to the attachment or side menu
		@json("from_attachment_menu", omitempty = true)
		fromAttachmentMenu bool
	}

	// This object represents a service message about a video chat scheduled in the chat.
	struct VideoChatScheduled {
		// Point in time (Unix timestamp) when the video chat is supposed to be started by a chat
		// administrator
		@json("start_date")
		startDate int
	}

	// This object represents a service message about a video chat started in the chat.
	struct VideoChatStarted {
		@json(omitempty = true)
		unused bool
	}

	// This object represents a service message about a video chat ended in the chat.
	struct VideoChatEnded {
		// Video chat duration in seconds
		duration int
	}

	// This object represents a service message about new members invited to a video chat.
	struct VideoChatParticipantsInvited {
		// New members that were invited to the video chat
		users User[]
	}

	// Describes a service message about a change in the price of paid messages within a chat.
	struct PaidMessagePriceChanged {
		// The new number of Telegram Stars that must be paid by non-administrator users of the
		// supergroup chat for each sent message
		@json("paid_message_star_count")
		paidMessageStarCount int
	}

	// Describes a service message about a change in the price of direct messages sent to a
	// channel chat.
	struct DirectMessagePriceChanged {
		// True, if direct messages are enabled for the channel chat; False otherwise
		@json("are_direct_messages_enabled")
		areDirectMessagesEnabled bool
		// The new number of Telegram Stars that must be paid by users for each direct message sent
		// to the channel.
		@json("direct_message_star_count", omitempty = true)
		directMessageStarCount int
	}

	// Describes a service message about the approval of a suggested post.
	struct SuggestedPostApproved {
		// Message containing the suggested post.
		@json("suggested_post_message", omitempty = true)
		suggestedPostMessage ?Message = none
		// Amount paid for the post
		@json(omitempty = true)
		price ?SuggestedPostPrice = none
		// Date when the post will be published
		@json("send_date")
		sendDate int
	}

	// Describes a service message about the failed approval of a suggested post.
	struct SuggestedPostApprovalFailed {
		// Message containing the suggested post whose approval has failed.
		@json("suggested_post_message", omitempty = true)
		suggestedPostMessage ?Message = none
		// Expected price of the post
		price SuggestedPostPrice
	}

	// Describes a service message about the rejection of a suggested post.
	struct SuggestedPostDeclined {
		// Message containing the suggested post.
		@json("suggested_post_message", omitempty = true)
		suggestedPostMessage ?Message = none
		// Comment with which the post was declined
		@json(omitempty = true)
		comment string
	}

	// Describes a service message about a successful payment for a suggested post.
	struct SuggestedPostPaid {
		// Message containing the suggested post.
		@json("suggested_post_message", omitempty = true)
		suggestedPostMessage ?Message = none
		// Currency in which the payment was made.
		currency string
		// The amount of the currency that was received by the channel in nanograms; for payments
		// in TON grams only
		@json(omitempty = true)
		amount int
		// The amount of Telegram Stars that was received by the channel; for payments in Telegram
		// Stars only
		@json("star_amount", omitempty = true)
		starAmount ?StarAmount = none
	}

	// Describes a service message about a payment refund for a suggested post.
	struct SuggestedPostRefunded {
		// Message containing the suggested post.
		@json("suggested_post_message", omitempty = true)
		suggestedPostMessage ?Message = none
		// Reason for the refund.
		reason string
	}

	// This object represents a service message about the creation of a scheduled giveaway.
	struct GiveawayCreated {
		// The number of Telegram Stars to be split between giveaway winners; for Telegram Star
		// giveaways only
		@json("prize_star_count", omitempty = true)
		prizeStarCount int
	}

	// This object represents a message about a scheduled giveaway.
	struct Giveaway {
		// The list of chats which the user must join to participate in the giveaway
		chats Chat[]
		// Point in time (Unix timestamp) when winners of the giveaway will be selected
		@json("winners_selection_date")
		winnersSelectionDate int
		// The number of users which are supposed to be selected as winners of the giveaway
		@json("winner_count")
		winnerCount int
		// True, if only users who join the chats after the giveaway started should be eligible to
		// win
		@json("only_new_members", omitempty = true)
		onlyNewMembers bool
		// True, if the list of giveaway winners will be visible to everyone
		@json("has_public_winners", omitempty = true)
		hasPublicWinners bool
		// Description of additional giveaway prize
		@json("prize_description", omitempty = true)
		prizeDescription string
		// A list of two-letter ISO 3166-1 alpha-2 country codes indicating the countries from
		// which eligible users for the giveaway must come.
		@json("country_codes", omitempty = true)
		countryCodes string[]
		// The number of Telegram Stars to be split between giveaway winners; for Telegram Star
		// giveaways only
		@json("prize_star_count", omitempty = true)
		prizeStarCount int
		// The number of months the Telegram Premium subscription won from the giveaway will be
		// active for; for Telegram Premium giveaways only
		@json("premium_subscription_month_count", omitempty = true)
		premiumSubscriptionMonthCount int
	}

	// This object represents a message about the completion of a giveaway with public winners.
	struct GiveawayWinners {
		// The chat that created the giveaway
		chat Chat
		// Identifier of the message with the giveaway in the chat
		@json("giveaway_message_id")
		giveawayMessageId int
		// Point in time (Unix timestamp) when winners of the giveaway were selected
		@json("winners_selection_date")
		winnersSelectionDate int
		// Total number of winners in the giveaway
		@json("winner_count")
		winnerCount int
		// List of up to 100 winners of the giveaway
		winners User[]
		// The number of other chats the user had to join in order to be eligible for the giveaway
		@json("additional_chat_count", omitempty = true)
		additionalChatCount int
		// The number of Telegram Stars that were split between giveaway winners; for Telegram Star
		// giveaways only
		@json("prize_star_count", omitempty = true)
		prizeStarCount int
		// The number of months the Telegram Premium subscription won from the giveaway will be
		// active for; for Telegram Premium giveaways only
		@json("premium_subscription_month_count", omitempty = true)
		premiumSubscriptionMonthCount int
		// Number of undistributed prizes
		@json("unclaimed_prize_count", omitempty = true)
		unclaimedPrizeCount int
		// True, if only users who had joined the chats after the giveaway started were eligible to
		// win
		@json("only_new_members", omitempty = true)
		onlyNewMembers bool
		// True, if the giveaway was canceled because the payment for it was refunded
		@json("was_refunded", omitempty = true)
		wasRefunded bool
		// Description of additional giveaway prize
		@json("prize_description", omitempty = true)
		prizeDescription string
	}

	// This object represents a service message about the completion of a giveaway without
	// public winners.
	struct GiveawayCompleted {
		// Number of winners in the giveaway
		@json("winner_count")
		winnerCount int
		// Number of undistributed prizes
		@json("unclaimed_prize_count", omitempty = true)
		unclaimedPrizeCount int
		// Message with the giveaway that was completed, if it wasn't deleted
		@json("giveaway_message", omitempty = true)
		giveawayMessage ?Message = none
		// True, if the giveaway is a Telegram Star giveaway.
		@json("is_star_giveaway", omitempty = true)
		isStarGiveaway bool
	}

	// Describes the options used for link preview generation.
	struct LinkPreviewOptions {
		// True, if the link preview is disabled
		@json("is_disabled", omitempty = true)
		isDisabled bool
		// URL to use for the link preview.
		@json(omitempty = true)
		url string
		// True, if the media in the link preview is supposed to be shrunk; ignored if the URL
		// isn't explicitly specified or media size change isn't supported for the preview
		@json("prefer_small_media", omitempty = true)
		preferSmallMedia bool
		// True, if the media in the link preview is supposed to be enlarged; ignored if the URL
		// isn't explicitly specified or media size change isn't supported for the preview
		@json("prefer_large_media", omitempty = true)
		preferLargeMedia bool
		// True, if the link preview must be shown above the message text; otherwise, the link
		// preview will be shown below the message text
		@json("show_above_text", omitempty = true)
		showAboveText bool
	}

	// Describes the price of a suggested post.
	struct SuggestedPostPrice {
		// Currency in which the post will be paid.
		currency string
		// The amount of the currency that will be paid for the post in the smallest units of the
		// currency, i.e.
		amount int
	}

	// Contains information about a suggested post.
	struct SuggestedPostInfo {
		// State of the suggested post.
		state string
		// Proposed price of the post.
		@json(omitempty = true)
		price ?SuggestedPostPrice = none
		// Proposed send date of the post.
		@json("send_date", omitempty = true)
		sendDate int
	}

	// Contains parameters of a post that is being suggested by the bot.
	struct SuggestedPostParameters {
		// Proposed price for the post.
		@json(omitempty = true)
		price ?SuggestedPostPrice = none
		// Proposed send date of the post.
		@json("send_date", omitempty = true)
		sendDate int
	}

	// Describes a topic of a direct messages chat.
	struct DirectMessagesTopic {
		// Unique identifier of the topic.
		@json("topic_id")
		topicId int
		// Information about the user that created the topic.
		@json(omitempty = true)
		user ?User = none
	}

	// This object represent a user's profile pictures.
	struct UserProfilePhotos {
		// Total number of profile pictures the target user has
		@json("total_count")
		totalCount int
		// Requested profile pictures (in up to 4 sizes each)
		photos PhotoSize[][]
	}

	// This object represents the audios displayed on a user's profile.
	struct UserProfileAudios {
		// Total number of profile audios for the target user
		@json("total_count")
		totalCount int
		// Requested profile audios
		audios Audio[]
	}

	// This object represents a file ready to be downloaded.
	struct File {
		// Identifier for this file, which can be used to download or reuse the file
		@json("file_id")
		fileId string
		// Unique identifier for this file, which is supposed to be the same over time and for
		// different bots.
		@json("file_unique_id")
		fileUniqueId string
		// File size in bytes.
		@json("file_size", omitempty = true)
		fileSize int
		// File path.
		@json("file_path", omitempty = true)
		filePath string
	}

	// Describes a Web App.
	struct WebAppInfo {
		// An HTTPS URL of a Web App to be opened with additional data as specified in Initializing
		// Web Apps
		url string
	}

	// This object represents a custom keyboard with reply options (see Introduction to bots for
	// details and examples).
	struct ReplyKeyboardMarkup {
		// Array of button rows, each represented by an Array of KeyboardButton objects
		keyboard KeyboardButton[][]
		// Requests clients to always show the keyboard when the regular keyboard is hidden.
		@json("is_persistent", omitempty = true)
		isPersistent bool
		// Requests clients to resize the keyboard vertically for optimal fit (e.g., make the
		// keyboard smaller if there are just two rows of buttons).
		@json("resize_keyboard", omitempty = true)
		resizeKeyboard bool
		// Requests clients to hide the keyboard as soon as it's been used.
		@json("one_time_keyboard", omitempty = true)
		oneTimeKeyboard bool
		// The placeholder to be shown in the input field when the keyboard is active; 1-64
		// characters
		@json("input_field_placeholder", omitempty = true)
		inputFieldPlaceholder string
		// Use this parameter if you want to show the keyboard to specific users only.
		@json(omitempty = true)
		selective bool
		// Pass True if the reply interface must be shown to the user, as if they had manually
		// selected the bot's message and tapped 'Reply'
		@json("force_reply", omitempty = true)
		forceReply bool
	}

	// This object represents one button of the reply keyboard.
	struct KeyboardButton {
		// Text of the button.
		text string
		// Unique identifier of the custom emoji shown before the text of the button.
		@json("icon_custom_emoji_id", omitempty = true)
		iconCustomEmojiId string
		// Style of the button.
		@json("style", omitempty = true)
		styleValue string
		// If specified, pressing the button will open a list of suitable users.
		@json("request_users", omitempty = true)
		requestUsers ?KeyboardButtonRequestUsers = none
		// If specified, pressing the button will open a list of suitable chats.
		@json("request_chat", omitempty = true)
		requestChat ?KeyboardButtonRequestChat = none
		// If specified, pressing the button will ask the user to create and share a bot that will
		// be managed by the current bot.
		@json("request_managed_bot", omitempty = true)
		requestManagedBot ?KeyboardButtonRequestManagedBot = none
		// If True, the user's phone number will be sent as a contact when the button is pressed.
		@json("request_contact", omitempty = true)
		requestContact bool
		// If True, the user's current location will be sent when the button is pressed.
		@json("request_location", omitempty = true)
		requestLocation bool
		// If specified, the user will be asked to create a poll and send it to the bot when the
		// button is pressed.
		@json("request_poll", omitempty = true)
		requestPoll ?KeyboardButtonPollType = none
		// If specified, the described Web App will be launched when the button is pressed.
		@json("web_app", omitempty = true)
		webApp ?WebAppInfo = none
	}

	// This object defines the criteria used to request suitable users.
	struct KeyboardButtonRequestUsers {
		// Signed 32-bit identifier of the request that will be received back in the UsersShared
		// object.
		@json("request_id")
		requestId int
		// Pass True to request bots, pass False to request regular users.
		@json("user_is_bot", omitempty = true)
		userIsBot bool
		// Pass True to request premium users, pass False to request non-premium users.
		@json("user_is_premium", omitempty = true)
		userIsPremium bool
		// The maximum number of users to be selected; 1-10.
		@json("max_quantity", omitempty = true)
		maxQuantity int
		// Pass True to request the users' first and last names
		@json("request_name", omitempty = true)
		requestName bool
		// Pass True to request the users' usernames
		@json("request_username", omitempty = true)
		requestUsername bool
		// Pass True to request the users' photos
		@json("request_photo", omitempty = true)
		requestPhoto bool
	}

	// This object defines the criteria used to request a suitable chat.
	struct KeyboardButtonRequestChat {
		// Signed 32-bit identifier of the request, which will be received back in the ChatShared
		// object.
		@json("request_id")
		requestId int
		// Pass True to request a channel chat, pass False to request a group or a supergroup chat
		@json("chat_is_channel")
		chatIsChannel bool
		// Pass True to request a forum supergroup, pass False to request a non-forum chat.
		@json("chat_is_forum", omitempty = true)
		chatIsForum bool
		// Pass True to request a supergroup or a channel with a username, pass False to request a
		// chat without a username.
		@json("chat_has_username", omitempty = true)
		chatHasUsername bool
		// Pass True to request a chat owned by the user.
		@json("chat_is_created", omitempty = true)
		chatIsCreated bool
		// A JSON-serialized object listing the required administrator rights of the user in the
		// chat.
		@json("user_administrator_rights", omitempty = true)
		userAdministratorRights ?ChatAdministratorRights = none
		// A JSON-serialized object listing the required administrator rights of the bot in the
		// chat.
		@json("bot_administrator_rights", omitempty = true)
		botAdministratorRights ?ChatAdministratorRights = none
		// Pass True to request a chat with the bot as a member.
		@json("bot_is_member", omitempty = true)
		botIsMember bool
		// Pass True to request the chat's title
		@json("request_title", omitempty = true)
		requestTitle bool
		// Pass True to request the chat's username
		@json("request_username", omitempty = true)
		requestUsername bool
		// Pass True to request the chat's photo
		@json("request_photo", omitempty = true)
		requestPhoto bool
	}

	// This object defines the parameters for the creation of a managed bot.
	struct KeyboardButtonRequestManagedBot {
		// Signed 32-bit identifier of the request.
		@json("request_id")
		requestId int
		// Suggested name for the bot
		@json("suggested_name", omitempty = true)
		suggestedName string
		// Suggested username for the bot
		@json("suggested_username", omitempty = true)
		suggestedUsername string
	}

	// This object represents type of a poll, which is allowed to be created and sent when the
	// corresponding button is pressed.
	struct KeyboardButtonPollType {
		// If quiz is passed, the user will be allowed to create only polls in the quiz mode.
		@json("type", omitempty = true)
		kind string
	}

	// Upon receiving a message with this object, Telegram clients will remove the current
	// custom keyboard and display the default letter-keyboard.
	struct ReplyKeyboardRemove {
		// Requests clients to remove the custom keyboard (user will not be able to summon this
		// keyboard; if you want to hide the keyboard from sight but keep it accessible, use
		// one_time_keyboard in ReplyKeyboardMarkup)
		@json("remove_keyboard")
		removeKeyboard bool
		// Use this parameter if you want to remove the keyboard for specific users only.
		@json(omitempty = true)
		selective bool
	}

	// This object represents an inline keyboard that appears right next to the message it
	// belongs to.
	struct InlineKeyboardMarkup {
		// Array of button rows, each represented by an Array of InlineKeyboardButton objects
		@json("inline_keyboard")
		inlineKeyboard InlineKeyboardButton[][]
		// Pass True if the reply interface must be shown to the user, as if they had manually
		// selected the bot's message and tapped 'Reply'.
		@json("force_reply", omitempty = true)
		forceReply bool
	}

	// This object represents one button of an inline keyboard.
	struct InlineKeyboardButton {
		// Label text on the button
		text string
		// Unique identifier of the custom emoji shown before the text of the button.
		@json("icon_custom_emoji_id", omitempty = true)
		iconCustomEmojiId string
		// Style of the button.
		@json("style", omitempty = true)
		styleValue string
		// HTTP or tg:// URL to be opened when the button is pressed.
		@json(omitempty = true)
		url string
		// Data to be sent in a callback query to the bot when the button is pressed, 1-64 bytes
		@json("callback_data", omitempty = true)
		callbackData string
		// Description of the Web App that will be launched when the user presses the button.
		@json("web_app", omitempty = true)
		webApp ?WebAppInfo = none
		// An HTTPS URL used to automatically authorize the user.
		@json("login_url", omitempty = true)
		loginUrl ?LoginUrl = none
		// If set, pressing the button will prompt the user to select one of their chats, open that
		// chat and insert the bot's username and the specified inline query in the input field.
		@json("switch_inline_query", omitempty = true)
		switchInlineQuery string
		// If set, pressing the button will insert the bot's username and the specified inline
		// query in the current chat's input field.
		@json("switch_inline_query_current_chat", omitempty = true)
		switchInlineQueryCurrentChat string
		// If set, pressing the button will prompt the user to select one of their chats of the
		// specified type, open that chat and insert the bot's username and the specified inline
		// query in the input field.
		@json("switch_inline_query_chosen_chat", omitempty = true)
		switchInlineQueryChosenChat ?SwitchInlineQueryChosenChat = none
		// Description of the button that copies the specified text to the clipboard
		@json("copy_text", omitempty = true)
		copyText ?CopyTextButton = none
		// Description of the game that will be launched when the user presses the button.NOTE:
		// This type of button must always be the first button in the first row.
		@json("callback_game", omitempty = true)
		callbackGame ?CallbackGame = none
		// Specify True, to send a Pay button.
		@json(omitempty = true)
		pay bool
		// If set, then the button is disabled and does nothing
		@json(omitempty = true)
		disabled ?DisabledButton = none
	}

	// This object represents a parameter of the inline keyboard button used to automatically
	// authorize a user.
	struct LoginUrl {
		// An HTTPS URL to be opened with user authorization data added to the query string when
		// the button is pressed.
		url string
		// New text of the button in forwarded messages
		@json("forward_text", omitempty = true)
		forwardText string
		// Username of a bot, which will be used for user authorization; not supported in
		// RichMessageButton.
		@json("bot_username", omitempty = true)
		botUsername string
		// Pass True to request the permission for your bot to send messages to the user
		@json("request_write_access", omitempty = true)
		requestWriteAccess bool
	}

	// This object represents an inline button that switches the current user to inline mode in
	// a chosen chat, with an optional default inline query.
	struct SwitchInlineQueryChosenChat {
		// The default inline query to be inserted in the input field.
		@json(omitempty = true)
		query string
		// True, if private chats with users can be chosen
		@json("allow_user_chats", omitempty = true)
		allowUserChats bool
		// True, if private chats with bots can be chosen
		@json("allow_bot_chats", omitempty = true)
		allowBotChats bool
		// True, if group and supergroup chats can be chosen
		@json("allow_group_chats", omitempty = true)
		allowGroupChats bool
		// True, if channel chats can be chosen
		@json("allow_channel_chats", omitempty = true)
		allowChannelChats bool
	}

	// This object represents an inline keyboard button that copies specified text to the
	// clipboard.
	struct CopyTextButton {
		// The text to be copied to the clipboard; 1-256 characters
		text string
	}

	// This object represents a disabled button which does nothing.
	struct DisabledButton {
		@json(omitempty = true)
		unused bool
	}

	// This object represents an incoming callback query from a callback button in an inline
	// keyboard.
	struct CallbackQuery {
		// Unique identifier for this query
		id string
		// Sender
		from User
		// Message sent by the bot with the callback button that originated the query
		@json(omitempty = true)
		message ?MaybeInaccessibleMessage = none
		// Identifier of the message sent via the bot in inline mode, that originated the query
		@json("inline_message_id", omitempty = true)
		inlineMessageId string
		// Global identifier, uniquely corresponding to the chat to which the message with the
		// callback button was sent.
		@json("chat_instance")
		chatInstance string
		// Data associated with the callback button.
		@json(omitempty = true)
		data string
		// Short name of a Game to be returned, serves as the unique identifier for the game
		@json("game_short_name", omitempty = true)
		gameShortName string
	}

	// Upon receiving a message with this object, Telegram clients will display a reply
	// interface to the user (act as if the user has selected the bot's message and tapped
	// 'Reply').
	struct ForceReply {
		// Shows reply interface to the user, as if they had manually selected the bot's message
		// and tapped 'Reply'
		@json("force_reply")
		forceReply bool
		// The placeholder to be shown in the input field when the reply is active; 1-64 characters
		@json("input_field_placeholder", omitempty = true)
		inputFieldPlaceholder string
		// Use this parameter if you want to force reply from specific users only.
		@json(omitempty = true)
		selective bool
	}

	// Represents a community (a group of chats).
	struct Community {
		// Unique identifier for this community.
		id int
		// Name of the community
		name string
	}

	// This object represents a chat photo.
	struct ChatPhoto {
		// File identifier of small (160x160) chat photo.
		@json("small_file_id")
		smallFileId string
		// Unique file identifier of small (160x160) chat photo, which is supposed to be the same
		// over time and for different bots.
		@json("small_file_unique_id")
		smallFileUniqueId string
		// File identifier of big (640x640) chat photo.
		@json("big_file_id")
		bigFileId string
		// Unique file identifier of big (640x640) chat photo, which is supposed to be the same
		// over time and for different bots.
		@json("big_file_unique_id")
		bigFileUniqueId string
	}

	// Represents an invite link for a chat.
	struct ChatInviteLink {
		// The invite link.
		@json("invite_link")
		inviteLink string
		// Creator of the link
		creator User
		// True, if users joining the chat via the link need to be approved by chat administrators
		@json("creates_join_request")
		createsJoinRequest bool
		// True, if the link is primary
		@json("is_primary")
		isPrimary bool
		// True, if the link is revoked
		@json("is_revoked")
		isRevoked bool
		// Invite link name
		@json(omitempty = true)
		name string
		// Point in time (Unix timestamp) when the link will expire or has been expired
		@json("expire_date", omitempty = true)
		expireDate int
		// The maximum number of users that can be members of the chat simultaneously after joining
		// the chat via this invite link; 1-99999
		@json("member_limit", omitempty = true)
		memberLimit int
		// Number of pending join requests created using this link
		@json("pending_join_request_count", omitempty = true)
		pendingJoinRequestCount int
		// The number of seconds the subscription will be active for before the next payment
		@json("subscription_period", omitempty = true)
		subscriptionPeriod int
		// The amount of Telegram Stars a user must pay initially and after each subsequent
		// subscription period to be a member of the chat using the link
		@json("subscription_price", omitempty = true)
		subscriptionPrice int
	}

	// Represents the rights of an administrator in a chat.
	struct ChatAdministratorRights {
		// True, if the user's presence in the chat is hidden
		@json("is_anonymous")
		isAnonymous bool
		// True, if the administrator can access the chat event log, get boost list, see hidden
		// supergroup and channel members, report spam messages, ignore slow mode, and send
		// messages to the chat without paying Telegram Stars.
		@json("can_manage_chat")
		canManageChat bool
		// True, if the administrator can delete messages of other users
		@json("can_delete_messages")
		canDeleteMessages bool
		// True, if the administrator can manage video chats
		@json("can_manage_video_chats")
		canManageVideoChats bool
		// True, if the administrator can restrict, ban or unban chat members, or access supergroup
		// statistics
		@json("can_restrict_members")
		canRestrictMembers bool
		// True, if the administrator can add new administrators with a subset of their own
		// privileges or demote administrators that they have promoted, directly or indirectly
		// (promoted by administrators that were appointed by the user)
		@json("can_promote_members")
		canPromoteMembers bool
		// True, if the user is allowed to change the chat title, photo and other settings
		@json("can_change_info")
		canChangeInfo bool
		// True, if the user is allowed to invite new users to the chat
		@json("can_invite_users")
		canInviteUsers bool
		// True, if the administrator can post stories to the chat
		@json("can_post_stories")
		canPostStories bool
		// True, if the administrator can edit stories posted by other users, post stories to the
		// chat page, pin chat stories, and access the chat's story archive
		@json("can_edit_stories")
		canEditStories bool
		// True, if the administrator can delete stories posted by other users
		@json("can_delete_stories")
		canDeleteStories bool
		// True, if the administrator can post messages in the channel, approve suggested posts, or
		// access channel statistics; for channels only
		@json("can_post_messages", omitempty = true)
		canPostMessages bool
		// True, if the administrator can edit messages of other users and can pin messages; for
		// channels only
		@json("can_edit_messages", omitempty = true)
		canEditMessages bool
		// True, if the user is allowed to pin messages; for groups and supergroups only
		@json("can_pin_messages", omitempty = true)
		canPinMessages bool
		// True, if the user is allowed to create, rename, close, and reopen forum topics; for
		// supergroups only
		@json("can_manage_topics", omitempty = true)
		canManageTopics bool
		// True, if the administrator can manage direct messages of the channel and decline
		// suggested posts; for channels only
		@json("can_manage_direct_messages", omitempty = true)
		canManageDirectMessages bool
		// True, if the administrator can edit the tags of regular members; for groups and
		// supergroups only
		@json("can_manage_tags", omitempty = true)
		canManageTags bool
		// True, if the administrator can manage chat welcome messages or directly send them in the
		// case of bots
		@json("can_send_welcome_messages")
		canSendWelcomeMessages bool
	}

	// This object represents changes in the status of a chat member.
	struct ChatMemberUpdated {
		// Chat the user belongs to
		chat Chat
		// Performer of the action, which resulted in the change
		from User
		// Date the change was done in Unix time
		date int
		// Previous information about the chat member
		@json("old_chat_member")
		oldChatMember ChatMember
		// New information about the chat member
		@json("new_chat_member")
		newChatMember ChatMember
		// Chat invite link, which was used by the user to join the chat; for joining by invite
		// link events only
		@json("invite_link", omitempty = true)
		inviteLink ?ChatInviteLink = none
		// True, if the user joined the chat after sending a direct join request without using an
		// invite link and being approved by an administrator
		@json("via_join_request", omitempty = true)
		viaJoinRequest bool
		// True, if the user joined the chat via a chat folder invite link
		@json("via_chat_folder_invite_link", omitempty = true)
		viaChatFolderInviteLink bool
	}

	// This object contains information about one member of a chat.
	// One struct holds the fields of every kind: ChatMemberOwner, ChatMemberAdministrator, ChatMemberMember, ChatMemberRestricted, ChatMemberLeft, ChatMemberBanned.
	struct ChatMember {
		// The member's status in the chat, always “creator”
		@json(omitempty = true)
		status string
		// Information about the user
		@json(omitempty = true)
		user ?User = none
		// True, if the user's presence in the chat is hidden
		@json("is_anonymous", omitempty = true)
		isAnonymous bool
		// Optional.
		@json("custom_title", omitempty = true)
		customTitle string
		// True, if the bot is allowed to edit administrator privileges of that user
		@json("can_be_edited", omitempty = true)
		canBeEdited bool
		// True, if the administrator can access the chat event log, get boost list, see hidden
		// supergroup and channel members, report spam messages, ignore slow mode, and send
		// messages to the chat without paying Telegram Stars.
		@json("can_manage_chat", omitempty = true)
		canManageChat bool
		// True, if the administrator can delete messages of other users
		@json("can_delete_messages", omitempty = true)
		canDeleteMessages bool
		// True, if the administrator can manage video chats
		@json("can_manage_video_chats", omitempty = true)
		canManageVideoChats bool
		// True, if the administrator can restrict, ban or unban chat members, or access supergroup
		// statistics
		@json("can_restrict_members", omitempty = true)
		canRestrictMembers bool
		// True, if the administrator can add new administrators with a subset of their own
		// privileges or demote administrators that they have promoted, directly or indirectly
		// (promoted by administrators that were appointed by the user)
		@json("can_promote_members", omitempty = true)
		canPromoteMembers bool
		// True, if the user is allowed to change the chat title, photo and other settings
		@json("can_change_info", omitempty = true)
		canChangeInfo bool
		// True, if the user is allowed to invite new users to the chat
		@json("can_invite_users", omitempty = true)
		canInviteUsers bool
		// True, if the administrator can post stories to the chat
		@json("can_post_stories", omitempty = true)
		canPostStories bool
		// True, if the administrator can edit stories posted by other users, post stories to the
		// chat page, pin chat stories, and access the chat's story archive
		@json("can_edit_stories", omitempty = true)
		canEditStories bool
		// True, if the administrator can delete stories posted by other users
		@json("can_delete_stories", omitempty = true)
		canDeleteStories bool
		// Optional.
		@json("can_post_messages", omitempty = true)
		canPostMessages bool
		// Optional.
		@json("can_edit_messages", omitempty = true)
		canEditMessages bool
		// Optional.
		@json("can_pin_messages", omitempty = true)
		canPinMessages bool
		// Optional.
		@json("can_manage_topics", omitempty = true)
		canManageTopics bool
		// Optional.
		@json("can_manage_direct_messages", omitempty = true)
		canManageDirectMessages bool
		// Optional.
		@json("can_manage_tags", omitempty = true)
		canManageTags bool
		// True, if the administrator can manage chat welcome messages or directly send them in the
		// case of bots
		@json("can_send_welcome_messages", omitempty = true)
		canSendWelcomeMessages bool
		// Optional.
		@json(omitempty = true)
		tag string
		// Optional.
		@json("until_date", omitempty = true)
		untilDate int
		// True, if the user is a member of the chat at the moment of the request
		@json("is_member", omitempty = true)
		isMember bool
		// True, if the user is allowed to send text messages, rich messages, contacts, giveaways,
		// giveaway winners, invoices, locations and venues
		@json("can_send_messages", omitempty = true)
		canSendMessages bool
		// True, if the user is allowed to send audios
		@json("can_send_audios", omitempty = true)
		canSendAudios bool
		// True, if the user is allowed to send documents
		@json("can_send_documents", omitempty = true)
		canSendDocuments bool
		// True, if the user is allowed to send photos
		@json("can_send_photos", omitempty = true)
		canSendPhotos bool
		// True, if the user is allowed to send videos
		@json("can_send_videos", omitempty = true)
		canSendVideos bool
		// True, if the user is allowed to send video notes
		@json("can_send_video_notes", omitempty = true)
		canSendVideoNotes bool
		// True, if the user is allowed to send voice notes
		@json("can_send_voice_notes", omitempty = true)
		canSendVoiceNotes bool
		// True, if the user is allowed to send polls and checklists
		@json("can_send_polls", omitempty = true)
		canSendPolls bool
		// True, if the user is allowed to send animations, games, stickers and use inline bots
		@json("can_send_other_messages", omitempty = true)
		canSendOtherMessages bool
		// True, if the user is allowed to add web page previews to their messages
		@json("can_add_web_page_previews", omitempty = true)
		canAddWebPagePreviews bool
		// True, if the user is allowed to react to messages
		@json("can_react_to_messages", omitempty = true)
		canReactToMessages bool
		// True, if the user is allowed to edit their own tag
		@json("can_edit_tag", omitempty = true)
		canEditTag bool
	}

	// Represents a chat member that owns the chat and has all administrator privileges.
	struct ChatMemberOwner {
		// The member's status in the chat, always “creator”
		status string
		// Information about the user
