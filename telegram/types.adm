	// This object represents a sticker.
	struct Sticker {
		// Identifier for this file, which can be used to download or reuse the file
		@json("file_id")
		fileId string
		// Unique identifier for this file, which is supposed to be the same over time and for
		// different bots.
		@json("file_unique_id")
		fileUniqueId string
		// Type of the sticker, currently one of “regular”, “mask”, “custom_emoji”.
		@json("type")
		kind string
		// Sticker width
		width int
		// Sticker height
		height int
		// True, if the sticker is animated
		@json("is_animated")
		isAnimated bool
		// True, if the sticker is a video sticker
		@json("is_video")
		isVideo bool
		// Sticker thumbnail in the .WEBP or .JPG format
		@json(omitempty = true)
		thumbnail ?PhotoSize = none
		// Emoji associated with the sticker
		@json(omitempty = true)
		emoji string
		// Name of the sticker set to which the sticker belongs
		@json("set_name", omitempty = true)
		setName string
		// For premium regular stickers, premium animation for the sticker
		@json("premium_animation", omitempty = true)
		premiumAnimation ?File = none
		// For mask stickers, the position where the mask should be placed
		@json("mask_position", omitempty = true)
		maskPosition ?MaskPosition = none
		// For custom emoji stickers, unique identifier of the custom emoji
		@json("custom_emoji_id", omitempty = true)
		customEmojiId string
		// True, if the sticker must be repainted to a text color in messages, the color of the
		// Telegram Premium badge in emoji status, white color on chat photos, or another
		// appropriate color in other places
		@json("needs_repainting", omitempty = true)
		needsRepainting bool
		// File size in bytes
		@json("file_size", omitempty = true)
		fileSize int
	}

	// This object represents a sticker set.
	struct StickerSet {
		// Sticker set name
		name string
		// Sticker set title
		title string
		// Type of stickers in the set, currently one of “regular”, “mask”, “custom_emoji”
		@json("sticker_type")
		stickerType string
		// List of all set stickers
		stickers Sticker[]
		// Sticker set thumbnail in the .WEBP, .TGS, or .WEBM format
		@json(omitempty = true)
		thumbnail ?PhotoSize = none
	}

	// This object describes the position on faces where a mask should be placed by default.
	struct MaskPosition {
		// The part of the face relative to which the mask should be placed.
		point string
		// Shift by X-axis measured in widths of the mask scaled to the face size, from left to
		// right.
		@json("x_shift")
		xShift float
		// Shift by Y-axis measured in heights of the mask scaled to the face size, from top to
		// bottom.
		@json("y_shift")
		yShift float
		// Mask scaling coefficient.
		scale float
	}

	// This object describes a sticker to be added to a sticker set.
	struct InputSticker {
		// The added sticker.
		sticker any = none
		// Format of the added sticker, must be one of “static” for a .WEBP or .PNG image,
		// “animated” for a .TGS animation, “video” for a .WEBM video
		format string
		// List of 1-20 emoji associated with the sticker
		@json("emoji_list")
		emojiList string[]
		// Position where the mask should be placed on faces.
		@json("mask_position", omitempty = true)
		maskPosition ?MaskPosition = none
		// List of 0-20 search keywords for the sticker with total length of up to 64 characters.
		@json(omitempty = true)
		keywords string[]
	}

	// Rich formatted message.
	struct RichMessage {
		// Content of the message
		blocks RichBlock[]
		// True, if the rich message must be shown right-to-left
		@json("is_rtl", omitempty = true)
		isRtl bool
	}

	// Describes a rich message to be sent.
	struct InputRichMessage {
		// Content of the rich message to send described as a list of blocks
		@json(omitempty = true)
		blocks InputRichBlock[]
		// Content of the rich message to send described using HTML formatting.
		@json(omitempty = true)
		html string
		// Content of the rich message to send described using Markdown formatting.
		@json(omitempty = true)
		markdown string
		// List of media that are specified in the markdown or html fields using tg://photo?id=,
		// tg://video?id=, tg://document?id=, and tg://audio?id= links
		@json(omitempty = true)
		media InputRichMessageMedia[]
		// Pass True if the rich message must be shown right-to-left
		@json("is_rtl", omitempty = true)
		isRtl bool
		// Pass True to skip automatic detection of entities (e.g., URLs, email addresses, username
		// mentions, hashtags, cashtags, bot commands, or phone numbers) in the text
		@json("skip_entity_detection", omitempty = true)
		skipEntityDetection bool
	}

	// Describes a media element embedded in an outgoing rich message.
	struct InputRichMessageMedia {
		// Unique identifier of the media used in a tg://photo?id=, tg://video?id=,
		// tg://document?id=, or tg://audio?id= link.
		id string
		// The media to be sent.
		media any = none
	}

	// This object represents a button in a RichMessage.
	struct RichMessageButton {
		// Text of the button.
		text RichText
		// Style of the button.
		@json("style", omitempty = true)
		styleValue string
		// HTTP or tg:// URL to be opened when the button is pressed.
		@json(omitempty = true)
		url string
		// Data to be sent in a callback query to the bot when the button is pressed, 1-64 bytes
		@json("callback_data", omitempty = true)
		callbackData string
		// Description of the Web App that will be launched when the user presses the button.
		@json("web_app", omitempty = true)
		webApp ?WebAppInfo = none
		// An HTTPS URL used to automatically authorize the user.
		@json("login_url", omitempty = true)
		loginUrl ?LoginUrl = none
		// If set, pressing the button will prompt the user to select one of their chats, open that
		// chat and insert the bot's username and the specified inline query in the input field.
		@json("switch_inline_query", omitempty = true)
		switchInlineQuery string
		// If set, pressing the button will insert the bot's username and the specified inline
		// query in the current chat's input field.
		@json("switch_inline_query_current_chat", omitempty = true)
		switchInlineQueryCurrentChat string
		// If set, pressing the button will prompt the user to select one of their chats of the
		// specified type, open that chat and insert the bot's username and the specified inline
		// query in the input field.
		@json("switch_inline_query_chosen_chat", omitempty = true)
		switchInlineQueryChosenChat ?SwitchInlineQueryChosenChat = none
		// A button that copies the specified text to the clipboard
		@json("copy_text", omitempty = true)
		copyText ?CopyTextButton = none
		// If set, then the button is disabled and does nothing
		@json(omitempty = true)
		disabled ?DisabledButton = none
	}

	// This object represents a rich formatted text.
	// One struct holds the fields of every kind: RichTextBold, RichTextItalic, RichTextUnderline, RichTextStrikethrough, RichTextSpoiler, RichTextDateTime, RichTextTextMention, RichTextSubscript, RichTextSuperscript, RichTextMarked, RichTextCode, RichTextCustomEmoji, RichTextMathematicalExpression, RichTextUrl, RichTextEmailAddress, RichTextPhoneNumber, RichTextBankCardNumber, RichTextMention, RichTextHashtag, RichTextCashtag, RichTextBotCommand, RichTextButton, RichTextAnchor, RichTextAnchorLink, RichTextReference, RichTextReferenceLink.
	struct RichText {
		// Type of the rich text, always “bold”
		@json("type", omitempty = true)
		kind string
		// The text
		@json(omitempty = true)
		text ?RichText = none
		// The Unix time associated with the entity
		@json("unix_time", omitempty = true)
		unixTime int
		// The string that defines the formatting of the date and time.
		@json("date_time_format", omitempty = true)
		dateTimeFormat string
		// The mentioned user
		@json(omitempty = true)
		user ?User = none
		// Unique identifier of the custom emoji.
		@json("custom_emoji_id", omitempty = true)
		customEmojiId string
		// Alternative emoji for the custom emoji
		@json("alternative_text", omitempty = true)
		alternativeText string
		// The expression in LaTeX format
		@json(omitempty = true)
		expression string
		// URL of the link
		@json(omitempty = true)
		url string
		// The email address
		@json("email_address", omitempty = true)
		emailAddress string
		// The phone number
		@json("phone_number", omitempty = true)
		phoneNumber string
		// The bank card number
		@json("bank_card_number", omitempty = true)
		bankCardNumber string
		// The username
		@json(omitempty = true)
		username string
		// The hashtag
		@json(omitempty = true)
		hashtag string
		// The cashtag
		@json(omitempty = true)
		cashtag string
		// The bot command
		@json("bot_command", omitempty = true)
		botCommand string
		// The button
		@json(omitempty = true)
		button ?RichMessageButton = none
		// The name of the anchor
		@json(omitempty = true)
		name string
		// The name of the anchor.
		@json("anchor_name", omitempty = true)
		anchorName string
		// The name of the reference
		@json("reference_name", omitempty = true)
		referenceName string
	}

