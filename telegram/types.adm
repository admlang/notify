		// True, if the item has a checkbox
		@json("has_checkbox", omitempty = true)
		hasCheckbox bool
		// True, if the item has a checked checkbox
		@json("is_checked", omitempty = true)
		isChecked bool
		// For ordered lists, the numeric value of the item label
		@json(omitempty = true)
		value int
		// For ordered lists, the type of the item label; must be one of “a” for lowercase letters,
		// “A” for uppercase letters, “i” for lowercase Roman numerals, “I” for uppercase Roman
		// numerals, or “1” for decimal numbers
		@json("type", omitempty = true)
		kind string
	}

	// This object represents a block in a rich formatted message.
	// One struct holds the fields of every kind: RichBlockParagraph, RichBlockSectionHeading, RichBlockPreformatted, RichBlockFooter, RichBlockDivider, RichBlockMathematicalExpression, RichBlockAnchor, RichBlockList, RichBlockBlockQuotation, RichBlockExpandableBlockQuotation, RichBlockPullQuotation, RichBlockCollage, RichBlockSlideshow, RichBlockTable, RichBlockDetails, RichBlockMap, RichBlockButtons, RichBlockAnimation, RichBlockAudio, RichBlockDocument, RichBlockPhoto, RichBlockVideo, RichBlockVoiceNote, RichBlockThinking.
	struct RichBlock {
		// Type of the block, always “paragraph”
		@json("type", omitempty = true)
		kind string
		// Text of the block
		@json(omitempty = true)
		text ?RichText = none
		// Relative size of the text font; 1-6, 1 is the largest, 6 is the smallest
		@json(omitempty = true)
		size int
		// Optional.
		@json(omitempty = true)
		language string
		// The mathematical expression in LaTeX format
		@json(omitempty = true)
		expression string
		// The name of the anchor
		@json(omitempty = true)
		name string
		// Items of the list
		@json(omitempty = true)
		items RichBlockListItem[]
		// Content of the block
		@json(omitempty = true)
		blocks RichBlock[]
		// Optional.
		@json(omitempty = true)
		credit ?RichText = none
		// Optional.
		@json(omitempty = true)
		caption ?RichBlockCaption = none
		// Cells of the table
		@json(omitempty = true)
		cells RichBlockTableCell[][]
		// Optional.
		@json("is_bordered", omitempty = true)
		isBordered bool
		// Optional.
		@json("is_striped", omitempty = true)
		isStriped bool
		// Optional.
		@json("is_compact", omitempty = true)
		isCompact bool
		// Always shown summary of the block
		@json(omitempty = true)
		summary ?RichText = none
		// Optional.
		@json("is_open", omitempty = true)
		isOpen bool
		// Location of the center of the map
		@json(omitempty = true)
		location ?Location = none
		// Map zoom level
		@json(omitempty = true)
		zoom int
		// Expected width of the map
		@json(omitempty = true)
		width int
		// Expected height of the map
		@json(omitempty = true)
		height int
		// The buttons
		@json(omitempty = true)
		buttons RichMessageButton[]
		// Optional.
		@json(omitempty = true)
		align string
		// The animation
		@json(omitempty = true)
		animation ?Animation = none
		// Optional.
		@json("has_spoiler", omitempty = true)
		hasSpoiler bool
		// The audio
		@json(omitempty = true)
		audio ?Audio = none
		// The document
		@json(omitempty = true)
		document ?Document = none
		// Available sizes of the photo
		@json(omitempty = true)
		photo PhotoSize[]
		// The video
		@json(omitempty = true)
		video ?Video = none
		// The voice note
		@json("voice_note", omitempty = true)
		voiceNote ?Voice = none
	}

	// A text paragraph, corresponding to the HTML tag <p>.
	struct RichBlockParagraph {
		// Type of the block, always “paragraph”
