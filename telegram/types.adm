		@json("managed_bot_created", omitempty = true)
		managedBotCreated ?ManagedBotCreated = none
		// Service message: the price for paid messages has changed in the chat
		@json("paid_message_price_changed", omitempty = true)
		paidMessagePriceChanged ?PaidMessagePriceChanged = none
