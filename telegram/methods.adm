		// Use this method to send invoices.
		// Fails as every call does.
		def sendInvoice(chatId any, title string, description string, payload string, currency string, prices LabeledPrice[], messageThreadId ?int = none, directMessagesTopicId ?int = none, providerToken ?string = none, maxTipAmount ?int = none, suggestedTipAmounts int[] = [], startParameter ?string = none, providerData ?string = none, photoUrl ?string = none, photoSize ?int = none, photoWidth ?int = none, photoHeight ?int = none, needName ?bool = none, needPhoneNumber ?bool = none, needEmail ?bool = none, needShippingAddress ?bool = none, sendPhoneNumberToProvider ?bool = none, sendEmailToProvider ?bool = none, isFlexible ?bool = none, disableNotification ?bool = none, protectContent ?bool = none, allowPaidBroadcast ?bool = none, messageEffectId ?string = none, suggestedPostParameters ?SuggestedPostParameters = none, replyParameters ?ReplyParameters = none, replyMarkup ?InlineKeyboardMarkup = none) !Message {
			let params = new map<string, any>()
			params.set("chat_id", chatId)
			params.set("title", title)
			params.set("description", description)
			params.set("payload", payload)
			params.set("currency", currency)
			params.set("prices", prices)
			params.set("message_thread_id", messageThreadId) unless messageThreadId is none
			params.set("direct_messages_topic_id", directMessagesTopicId) unless directMessagesTopicId is none
			params.set("provider_token", providerToken) unless providerToken is none
			params.set("max_tip_amount", maxTipAmount) unless maxTipAmount is none
			params.set("suggested_tip_amounts", suggestedTipAmounts) when suggestedTipAmounts.len() > 0
			params.set("start_parameter", startParameter) unless startParameter is none
			params.set("provider_data", providerData) unless providerData is none
			params.set("photo_url", photoUrl) unless photoUrl is none
			params.set("photo_size", photoSize) unless photoSize is none
			params.set("photo_width", photoWidth) unless photoWidth is none
			params.set("photo_height", photoHeight) unless photoHeight is none
			params.set("need_name", needName) unless needName is none
			params.set("need_phone_number", needPhoneNumber) unless needPhoneNumber is none
			params.set("need_email", needEmail) unless needEmail is none
			params.set("need_shipping_address", needShippingAddress) unless needShippingAddress is none
			params.set("send_phone_number_to_provider", sendPhoneNumberToProvider) unless sendPhoneNumberToProvider is none
			params.set("send_email_to_provider", sendEmailToProvider) unless sendEmailToProvider is none
			params.set("is_flexible", isFlexible) unless isFlexible is none
			params.set("disable_notification", disableNotification) unless disableNotification is none
			params.set("protect_content", protectContent) unless protectContent is none
			params.set("allow_paid_broadcast", allowPaidBroadcast) unless allowPaidBroadcast is none
			params.set("message_effect_id", messageEffectId) unless messageEffectId is none
			params.set("suggested_post_parameters", suggestedPostParameters) unless suggestedPostParameters is none
			params.set("reply_parameters", replyParameters) unless replyParameters is none
			params.set("reply_markup", replyMarkup) unless replyMarkup is none
			let reply = new Reply<Message>()
			reply.result = Message{}
			try call(self, "sendInvoice", params, reply)
			return reply.result
		}

		// Use this method to create a link for an invoice.
		// Fails as every call does.
		def createInvoiceLink(title string, description string, payload string, currency string, prices LabeledPrice[], businessConnectionId ?string = none, providerToken ?string = none, subscriptionPeriod ?int = none, maxTipAmount ?int = none, suggestedTipAmounts int[] = [], providerData ?string = none, photoUrl ?string = none, photoSize ?int = none, photoWidth ?int = none, photoHeight ?int = none, needName ?bool = none, needPhoneNumber ?bool = none, needEmail ?bool = none, needShippingAddress ?bool = none, sendPhoneNumberToProvider ?bool = none, sendEmailToProvider ?bool = none, isFlexible ?bool = none) !string {
			let params = new map<string, any>()
			params.set("title", title)
			params.set("description", description)
			params.set("payload", payload)
			params.set("currency", currency)
			params.set("prices", prices)
			params.set("business_connection_id", businessConnectionId) unless businessConnectionId is none
			params.set("provider_token", providerToken) unless providerToken is none
			params.set("subscription_period", subscriptionPeriod) unless subscriptionPeriod is none
			params.set("max_tip_amount", maxTipAmount) unless maxTipAmount is none
			params.set("suggested_tip_amounts", suggestedTipAmounts) when suggestedTipAmounts.len() > 0
			params.set("provider_data", providerData) unless providerData is none
			params.set("photo_url", photoUrl) unless photoUrl is none
			params.set("photo_size", photoSize) unless photoSize is none
			params.set("photo_width", photoWidth) unless photoWidth is none
			params.set("photo_height", photoHeight) unless photoHeight is none
			params.set("need_name", needName) unless needName is none
			params.set("need_phone_number", needPhoneNumber) unless needPhoneNumber is none
			params.set("need_email", needEmail) unless needEmail is none
			params.set("need_shipping_address", needShippingAddress) unless needShippingAddress is none
			params.set("send_phone_number_to_provider", sendPhoneNumberToProvider) unless sendPhoneNumberToProvider is none
			params.set("send_email_to_provider", sendEmailToProvider) unless sendEmailToProvider is none
			params.set("is_flexible", isFlexible) unless isFlexible is none
			let reply = new Reply<string>()
			try call(self, "createInvoiceLink", params, reply)
			return reply.result
		}

		// If you sent an invoice requesting a shipping address and the parameter is_flexible was
		// specified, the Bot API will send an Update with a shipping_query field to the bot.
		// Fails as every call does.
		def answerShippingQuery(shippingQueryId string, ok bool, shippingOptions ShippingOption[] = [], errorMessage ?string = none) !bool {
			let params = new map<string, any>()
			params.set("shipping_query_id", shippingQueryId)
			params.set("ok", ok)
			params.set("shipping_options", shippingOptions) when shippingOptions.len() > 0
			params.set("error_message", errorMessage) unless errorMessage is none
			try call(self, "answerShippingQuery", params, none)
			return true
		}

		// Once the user has confirmed their payment and shipping details, the Bot API sends the
		// final confirmation in the form of an Update with the field pre_checkout_query.
		// Fails as every call does.
		def answerPreCheckoutQuery(preCheckoutQueryId string, ok bool, errorMessage ?string = none) !bool {
			let params = new map<string, any>()
			params.set("pre_checkout_query_id", preCheckoutQueryId)
			params.set("ok", ok)
			params.set("error_message", errorMessage) unless errorMessage is none
			try call(self, "answerPreCheckoutQuery", params, none)
			return true
		}

		// A method to get the current Telegram Stars balance of the bot.
		// Fails as every call does.
		def myStarBalance() !StarAmount {
			let params = new map<string, any>()
			let reply = new Reply<StarAmount>()
			reply.result = StarAmount{}
			try call(self, "getMyStarBalance", params, reply)
			return reply.result
		}

		// Returns the bot's Telegram Star transactions in chronological order.
		// Fails as every call does.
		def starTransactions(offset ?int = none, limit ?int = none) !StarTransactions {
			let params = new map<string, any>()
			params.set("offset", offset) unless offset is none
			params.set("limit", limit) unless limit is none
			let reply = new Reply<StarTransactions>()
			reply.result = StarTransactions{}
			try call(self, "getStarTransactions", params, reply)
			return reply.result
		}

		// Refunds a successful payment in Telegram Stars.
		// Fails as every call does.
		def refundStarPayment(userId int, telegramPaymentChargeId string) !bool {
			let params = new map<string, any>()
			params.set("user_id", userId)
			params.set("telegram_payment_charge_id", telegramPaymentChargeId)
			try call(self, "refundStarPayment", params, none)
			return true
		}

		// Allows the bot to cancel or re-enable extension of a subscription paid in Telegram
		// Stars.
		// Fails as every call does.
		def editUserStarSubscription(userId int, telegramPaymentChargeId string, isCanceled bool) !bool {
			let params = new map<string, any>()
			params.set("user_id", userId)
			params.set("telegram_payment_charge_id", telegramPaymentChargeId)
			params.set("is_canceled", isCanceled)
			try call(self, "editUserStarSubscription", params, none)
			return true
		}

		// Informs a user that some of the Telegram Passport elements they provided contains
		// errors.
		// Fails as every call does.
		def setPassportDataErrors(userId int, errors any[]) !bool {
			let params = new map<string, any>()
			params.set("user_id", userId)
			params.set("errors", errors)
			try call(self, "setPassportDataErrors", params, none)
			return true
		}

		// Use this method to send a game.
		// Fails as every call does.
		def sendGame(chatId any, gameShortName string, businessConnectionId ?string = none, messageThreadId ?int = none, disableNotification ?bool = none, protectContent ?bool = none, allowPaidBroadcast ?bool = none, messageEffectId ?string = none, replyParameters ?ReplyParameters = none, replyMarkup ?InlineKeyboardMarkup = none) !Message {
			let params = new map<string, any>()
			params.set("chat_id", chatId)
			params.set("game_short_name", gameShortName)
			params.set("business_connection_id", businessConnectionId) unless businessConnectionId is none
			params.set("message_thread_id", messageThreadId) unless messageThreadId is none
			params.set("disable_notification", disableNotification) unless disableNotification is none
			params.set("protect_content", protectContent) unless protectContent is none
			params.set("allow_paid_broadcast", allowPaidBroadcast) unless allowPaidBroadcast is none
			params.set("message_effect_id", messageEffectId) unless messageEffectId is none
			params.set("reply_parameters", replyParameters) unless replyParameters is none
			params.set("reply_markup", replyMarkup) unless replyMarkup is none
			let reply = new Reply<Message>()
			reply.result = Message{}
			try call(self, "sendGame", params, reply)
			return reply.result
		}

		// Use this method to set the score of the specified user in a game message.
		// Fails as every call does.
		def setGameScore(userId int, score int, force ?bool = none, disableEditMessage ?bool = none, chatId ?int = none, messageId ?int = none, inlineMessageId ?string = none) !?Message {
			let params = new map<string, any>()
			params.set("user_id", userId)
			params.set("score", score)
			params.set("force", force) unless force is none
			params.set("disable_edit_message", disableEditMessage) unless disableEditMessage is none
			params.set("chat_id", chatId) unless chatId is none
			params.set("message_id", messageId) unless messageId is none
			params.set("inline_message_id", inlineMessageId) unless inlineMessageId is none
			let reply = new Reply<Message>()
			reply.result = Message{}
			return none unless try call(self, "setGameScore", params, reply)
			return reply.result
		}

		// Use this method to get data for high score tables.
		// Fails as every call does.
		def gameHighScores(userId int, chatId ?int = none, messageId ?int = none, inlineMessageId ?string = none) !GameHighScore[] {
			let params = new map<string, any>()
			params.set("user_id", userId)
			params.set("chat_id", chatId) unless chatId is none
			params.set("message_id", messageId) unless messageId is none
			params.set("inline_message_id", inlineMessageId) unless inlineMessageId is none
			let reply = new Reply<GameHighScore[]>()
			try call(self, "getGameHighScores", params, reply)
			return reply.result
		}
	}
}
